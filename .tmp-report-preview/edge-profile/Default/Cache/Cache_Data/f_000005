n}\r\n\r\n.chat-group-header__caret:hover {\r\n  background: var(--mn-surface-2);\r\n}\r\n\r\n.chat-group-header__caret:focus-visible {\r\n  outline: 2px solid var(--mn-accent);\r\n  outline-offset: 1px;\r\n}\r\n\r\n.chat-group-header__name {\r\n  flex: 1;\r\n  min-width: 0;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n\r\n.chat-group-header__count {\r\n  font-weight: 400;\r\n  opacity: 0.8;\r\n}\r\n\r\n.chat-group-header__dot {\r\n  width: 8px;\r\n  height: 8px;\r\n  border-radius: 50%;\r\n  flex-shrink: 0;\r\n  display: none;\r\n}\r\n\r\n.chat-group-header__dot[data-dot-state='unread'] {\r\n  display: block;\r\n  background: var(--mn-success);\r\n}\r\n\r\n.chat-group-header__dot[data-dot-state='needs-input'] {\r\n  display: block;\r\n  background: var(--mn-warning);\r\n}\r\n\r\n.chat-group-header__dot[data-dot-state='error'] {\r\n  display: block;\r\n  background: var(--mn-danger);\r\n}\r\n\r\n.chat-group-context-menu {\r\n  position: fixed;\r\n  z-index: 100020;\r\n  min-width: 8rem;\r\n  padding: 4px;\r\n  border-radius: var(--radius-md);\r\n  border: 1px solid var(--mn-border);\r\n  background: var(--mn-surface-1);\r\n  box-shadow: var(--shadow-md);\r\n}\r\n\r\n.chat-group-context-menu button {\r\n  display: block;\r\n  width: 100%;\r\n  text-align: left;\r\n  padding: 6px 10px;\r\n  border: none;\r\n  background: transparent;\r\n  color: var(--mn-fg);\r\n  cursor: pointer;\r\n  font-size: 0.8rem;\r\n}\r\n\r\n.chat-group-context-menu button:hover:not(:disabled) {\r\n  background: var(--mn-surface-2);\r\n}\r\n\r\n.chat-group-context-menu button:disabled {\r\n  opacity: 0.45;\r\n  cursor: not-allowed;\r\n}\r\n\r\n.chat-group-context-menu .chat-context-menu__item--danger {\r\n  color: var(--mn-danger);\r\n}\r\n\r\n.chat-group-context-menu .chat-context-menu__item--danger:hover:not(:disabled) {\r\n  background: color-mix(in srgb, var(--mn-danger) 12%, transparent);\r\n}\r\n\r\n.chat-context-menu__sep {\r\n  margin: 4px 6px;