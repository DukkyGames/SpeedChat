t(.active) {\r\n    background: var(--mn-surface-elevated);\r\n    border-color: var(--mn-border);\r\n  }\r\n\r\n  /* Dark hover fill (--mn-surface-elevated) needs light title; skip active row */\r\n  .chat-item-row:hover:not(.active) .chat-item-title-row {\r\n    color: var(--mn-fg);\r\n  }\r\n}\r\n\r\n.chat-item-row.active {\r\n  border-color: var(--mn-accent);\r\n  background: var(--mn-accent-soft);\r\n}\r\n\r\n.chat-item-row--draft .chat-item-name {\r\n  color: var(--mn-fg-muted);\r\n  font-style: italic;\r\n}\r\n\r\n.chat-item-row--draft.active .chat-item-name {\r\n  color: var(--mn-fg);\r\n}\r\n\r\n.chat-item-row--selected:not(.active) {\r\n  background: color-mix(in srgb, var(--mn-accent) 8%, transparent);\r\n  border-color: color-mix(in srgb, var(--mn-accent) 30%, transparent);\r\n}\r\n\r\n.chat-item-row:focus-visible {\r\n  outline: 2px solid var(--mn-accent);\r\n  outline-offset: 2px;\r\n}\r\n\r\n/* Group member: name only; status rolls up to .chat-group-header__dot. */\r\n.chat-item-row.chat-item-row--in-group {\r\n  padding: 2px 8px;\r\n}\r\n\r\n.chat-item-row.chat-item-row--in-group .chat-item-name {\r\n  font-size: 10px;\r\n  font-weight: 500;\r\n}\r\n\r\n.chat-item-board-cat-icon {\r\n  --mn-icon-size: 10px;\r\n  flex-shrink: 0;\r\n  color: var(--mn-fg-muted);\r\n}\r\n\r\n@media (pointer: coarse) {\r\n  .chat-item-row.chat-item-row--in-group {\r\n    padding-top: 6px;\r\n    padding-bottom: 6px;\r\n  }\r\n}\r\n\r\n.chat-item-head {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 4px;\r\n  min-width: 0;\r\n}\r\n\r\n.chat-item-title-row {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 4px;\r\n  min-width: 0;\r\n  flex: 1;\r\n  transition: color 0.2s var(--ease-out);\r\n}\r\n\r\n.chat-item-name {\r\n  font-size: 11px;\r\n  font-weight: 500;\r\n  white-space: nowrap;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  flex: 1;\r\n  min-width: 0;\r\n}\r\n\r\n.chat-item-model {\r\n  font-size: 9px;\r\n  color: var(--mn-fg-subtle);\r\n