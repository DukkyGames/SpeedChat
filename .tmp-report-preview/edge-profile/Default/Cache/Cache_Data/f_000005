ents: none;\r\n}\r\n\r\n/* visibility, not just overflow, so collapsed rows leave the tab order. */\r\n.chat-sidebar.collapsed:not(.mobile-open) > * {\r\n  visibility: hidden;\r\n}\r\n\r\n/* Scrollable session list lives here. */\r\n.chat-sidebar-main {\r\n  display: flex;\r\n  flex-direction: column;\r\n  flex: 1;\r\n  min-height: 0;\r\n  overflow: hidden;\r\n}\r\n\r\n.chat-sidebar-header {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  padding: 10px 10px 8px;\r\n  border-bottom: 1px solid var(--mn-border);\r\n  flex-shrink: 0;\r\n}\r\n\r\n/* Search + new group: one bordered cluster, secondary to the New chat button */\r\n.chat-sidebar-header-actions {\r\n  display: inline-flex;\r\n  align-items: stretch;\r\n  flex-shrink: 0;\r\n  border: 1px solid var(--mn-border);\r\n  border-radius: var(--radius-sm);\r\n  overflow: hidden;\r\n  background: var(--mn-surface-1);\r\n}\r\n\r\n.chat-sidebar-header-actions .icon-btn {\r\n  width: 32px;\r\n  height: 32px;\r\n  border: none;\r\n  border-radius: 0;\r\n  background: transparent;\r\n  color: var(--mn-fg-muted);\r\n}\r\n\r\n/* Search glyph reads heavy at the default 18px inside the compact header cluster */\r\n#btnChatSearch .icon-svg {\r\n  --mn-icon-size: 16px;\r\n}\r\n\r\n.chat-sidebar-header-actions .icon-btn + .icon-btn {\r\n  border-left: 1px solid var(--mn-border);\r\n}\r\n\r\n.chat-sidebar-header-actions .icon-btn[aria-current='page'] {\r\n  background: var(--mn-accent-soft);\r\n  color: var(--mn-accent);\r\n}\r\n\r\n@media (hover: hover) and (pointer: fine) {\r\n  .chat-sidebar-header-actions .icon-btn:hover {\r\n    background: var(--mn-surface-elevated);\r\n    color: var(--mn-fg);\r\n    border-color: transparent;\r\n  }\r\n\r\n  .chat-sidebar-header-actions .icon-btn[aria-current='page']:hover {\r\n    background: var(--mn-accent-soft);\r\n    color: var(--mn-accent);\r\n  }\r\n}\r\n\r\n.chat-sidebar-title {\r\n  font-size: 11px;\r\n  font-weight: 600;\r\n  letter-spacing: 0.06em;\r\n  text-t