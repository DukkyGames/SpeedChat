ems: center;\r\n  gap: 8px;\r\n  margin-top: 8px;\r\n  font-size: 12px;\r\n  color: var(--mn-fg-muted);\r\n}\r\n\r\n.tool-start-indicator__label {\r\n  letter-spacing: 0.01em;\r\n}\r\n\r\n.tool-start-indicator__detail {\r\n  font-size: 11px;\r\n  font-weight: 500;\r\n  font-variant-numeric: tabular-nums;\r\n  color: var(--mn-fg-muted);\r\n}\r\n\r\n/* ── Expanded body ──────────────────────────────────────────────────────── */\r\n\r\n.tool-call-body {\r\n  display: none;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n  padding: 10px;\r\n  border-top: 1px solid color-mix(in srgb, var(--mn-border) 70%, transparent);\r\n}\r\n\r\n.tool-call-details[open] .tool-call-body {\r\n  display: flex;\r\n}\r\n\r\n.tool-call-section-label {\r\n  margin: 0;\r\n  font-family: var(--font-ui);\r\n  font-size: 10px;\r\n  font-weight: 600;\r\n  letter-spacing: 0.06em;\r\n  text-transform: uppercase;\r\n  color: var(--mn-fg-muted);\r\n}\r\n\r\n.tool-call-error {\r\n  margin: 0;\r\n  padding: 8px 10px;\r\n  border-radius: var(--radius-sm);\r\n  border: 1px solid var(--mn-danger-border);\r\n  background: var(--mn-danger-soft);\r\n  color: var(--mn-danger-ink, var(--mn-danger));\r\n  font-family: var(--font-ui);\r\n  font-size: 13px;\r\n  line-height: 1.45;\r\n  word-break: break-word;\r\n}\r\n\r\n.tool-call-pre {\r\n  margin: 0;\r\n  padding: 8px 10px;\r\n  border-radius: var(--radius-sm);\r\n  border: 1px solid var(--mn-border);\r\n  background: var(--mn-surface-0);\r\n  font-family: var(--font-mono);\r\n  font-size: 12px;\r\n  line-height: 1.45;\r\n  white-space: pre-wrap;\r\n  word-break: break-word;\r\n  overflow: auto;\r\n  max-height: 260px;\r\n}\r\n\r\n.tool-call-more {\r\n  margin: 0;\r\n  font-size: 12px;\r\n  color: var(--mn-fg-muted);\r\n}\r\n\r\n/* Row lists: directory entries, found paths, commits, git status */\r\n.tool-call-entries {\r\n  margin: 0;\r\n  padding: 0;\r\n  list-style: none;\r\n  font-family: var(--font-ui);\r\n  font-size: 13px;\r\n}\r\n\r\n.tool-call-entry {\r