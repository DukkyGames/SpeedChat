ize: 1.25rem; }\r\n.msg-bubble.msg-bubble--md h2 { font-size: 1.12rem; }\r\n.msg-bubble.msg-bubble--md h3,\r\n.msg-bubble.msg-bubble--md h4 { font-size: 1.02rem; }\r\n\r\n.msg-bubble.msg-bubble--md ul,\r\n.msg-bubble.msg-bubble--md ol {\r\n  margin: 0.5em 0;\r\n  padding-left: 1.35em;\r\n}\r\n\r\n.msg-bubble.msg-bubble--md li {\r\n  margin: 0.25em 0;\r\n}\r\n\r\n.msg-bubble.msg-bubble--md blockquote {\r\n  margin: 0.65em 0;\r\n  padding: 0.45em 0.75em;\r\n  border: 1px solid var(--mn-border);\r\n  border-radius: var(--radius-sm);\r\n  background: var(--mn-surface-0);\r\n  color: var(--mn-fg-muted);\r\n}\r\n\r\n.msg-bubble.msg-bubble--md a {\r\n  color: var(--mn-syntax-link);\r\n  text-decoration: underline;\r\n  text-underline-offset: 2px;\r\n}\r\n\r\n.msg-bubble.msg-bubble--md a:hover {\r\n  color: var(--mn-fg);\r\n}\r\n\r\n.msg-bubble.msg-bubble--md table {\r\n  border-collapse: collapse;\r\n  margin: 0.65em 0;\r\n  font-size: 13px;\r\n  max-width: 100%;\r\n  display: block;\r\n  overflow-x: auto;\r\n}\r\n\r\n.msg-bubble.msg-bubble--md th,\r\n.msg-bubble.msg-bubble--md td {\r\n  border: 1px solid var(--mn-border);\r\n  padding: 6px 10px;\r\n  text-align: left;\r\n}\r\n\r\n.msg-bubble.msg-bubble--md th {\r\n  background: var(--mn-surface-2);\r\n}\r\n\r\n/* Inline code inside prose */\r\n.msg-bubble.msg-bubble--md code:not(pre code) {\r\n  font-family: var(--font-mono);\r\n  font-size: 0.9em;\r\n  padding: 0.12em 0.4em;\r\n  border-radius: var(--radius-sm);\r\n  background: var(--mn-surface-0);\r\n  border: 1px solid var(--mn-border);\r\n  color: var(--mn-syntax-inline);\r\n}\r\n\r\n/* Fenced code blocks: shell around hljs theme */\r\n.msg-bubble.msg-bubble--md pre {\r\n  position: relative;\r\n  margin: 0.75em 0;\r\n  padding: 12px 14px;\r\n  border-radius: var(--radius-md);\r\n  border: 1px solid var(--mn-border);\r\n  /* Slight lift from bubble bg so fenced blocks stay readable (tokens file uses dark overlay elsewhere) */\r\n  background: var(--mn-surface-0);\r\n  overflow-x: auto;\r\n  max-width: 100%;\r\n}\r\n\r\n.msg-bubble.msg-bubble--md pre code {\r\n  font-family: var(--font-mono);\r\n  font-size: 13px;\r\n  line-height: 1.5;\r\n  display: block;\r\n  background: transparent !important;\r\n  border: none;\r\n  padding: 0;\r\n}\r\n\r\n.msg-bubble.msg-bubble--md pre .hljs {\r\n  background: transparent !important;\r\n}\r\n\r\n/* Light themes: remap highlight.js github classes to palette tokens (MIN-243). */\r\nhtml[data-theme$='-light'] .msg-bubble.msg-bubble--md pre .hljs {\r\n  color: var(--mn-fg);\r\n}\r\n\r\nhtml[data-theme$='-light'] .msg-bubble.msg-bubble--md pre .hljs-comment,\r\nhtml[data-theme$='-light'] .msg-bubble.msg-bubble--md pre .hljs-quote,\r\nhtml[data-theme$='-light'] .msg-bubble.msg-bubble--md pre .hljs-formula {\r\n  color: var(--mn-fg-muted);\r\n}\r\n\r\nhtml[data-theme$='-light'] .msg-bubble.msg-bubble--md pre .hljs-keyword,\r\nhtml[data-theme$='-light'] .msg-bubble.msg-bubble--md pre .hljs-meta .hljs-keyword,\r\nhtml[data-theme$='-light'] .msg-bubble.msg-bubble--md pre .hljs-template-tag,\r\nhtml[data-theme$='-light'] .msg-bubble.msg-bubble--md pre .hljs-template-variable,\r\nhtml[data-theme$='-light'] .msg-bubble.msg-bubble--md pre .hljs-type,\r\nhtml[data-theme$='-light'] .msg-bubble.msg-bubble--md pre .hljs-variable.language_ {\r\n  color: var(--cm-keyword);\r\n}\r\n\r\nhtml[data-theme$='-light'] .msg-bubble.msg-bubble--md pre .hljs-title,\r\nhtml[data-theme$='-light'] .msg-bubble.msg-bubble--md pre .hljs-title.class_,\r\nhtml[data-theme$='-light'] .msg-bubble.msg-bubble--md pre .hljs-title.class_.inherited__,\r\nhtml[data-theme$='-light'] .msg-bubble.msg-bubble--md pre .hljs-title.function_ {\r\n  color: var(--cm-title);\r\n}\r\n\r\nhtml[data-theme$='-light'] .msg-bubble.msg-bubble--md pre .hljs-attr,\r\nhtml[data-theme$='-light'] .msg-bubble.msg-bubble--md pre .hljs-attribute,\r\nhtml[data-theme$='-light'] .msg-bubble.msg-bubble--md pre .hljs-literal,\r\nhtml[data-theme$='-light'] .msg-bubble.msg-bubble--md pre .hljs-meta,\r\nhtml[data-theme$='-light'] .msg-bubble.msg-bubble--md pre .hljs-number,\r\nhtml[data-theme$='-light'] .msg-bubble.msg-bubble--md pre .hljs-operator,\r\nhtml[data-theme$='-light'] .msg-bubble.msg-bubble--md pre .hljs-selector-attr,\r\nhtml[data-theme$='-light'] .msg-bubble.msg-bubble--md pre .hljs-selector-class,\r\nhtml[data-theme$='-light'] .msg-bubble.msg-bubble--md pre .hljs-selector-id,\r\nhtml[data-theme$='-light'] .msg-bubble.msg-bubble--md pre .hljs-variable {\r\n  color: var(--cm-attr);\r\n}\r\n\r\nhtml[data-theme$='-light'] .msg-bubble.msg-bubble--md pre .hljs-meta .hljs-string,\r\nhtml[data-theme$='-light'] .msg-bubble.msg-bubble--md pre .hljs-regexp,\r\nhtml[data-theme$='-light'] .msg-bubble.msg-bubble--md pre .hljs-string {\r\n  color: var(--cm-string);\r\n}\r\n\r\nhtml[data-theme$='-light'] .msg-bubble.msg-bubble--md pre .hljs-built_in,\r\nhtml[data-theme$='-light'] .msg-bubble.msg-bubble--md pre .hljs-symbol {\r\n  color: var(--mn-warning);\r\n}\r\n\r\nhtml[data-theme$='-light'] .msg-bubble.msg-bubble--md pre .hljs-name,\r\nhtml[data-theme$='-light'] .msg-bubble.msg-bubble--md pre .hljs-selector-pseudo,\r\nhtml[data-theme$='-light'] .msg-bubble.msg-bubble--md pre .hljs-selector-tag {\r\n  color: var(--mn-success-ink);\r\n}\r\n\r\n.msg-bubble.msg-bubble--md pre[data-lang]::before {\r\n  content: attr(data-lang);\r\n  display: block;\r\n  font-family: var(--font-mono);\r\n  font-size: 10px;\r\n  letter-spacing: 0.04em;\r\n  text-transform: uppercase;\r\n  color: var(--mn-fg-muted);\r\n  margin-bottom: 8px;\r\n}\r\n\r\n/* Streaming caret. Match `.cursor--prose` only — a bare `.cursor` class in\r\n   model HTML would otherwise keep blinking after the reply settles. */\r\n.cursor--prose {\r\n  display: inline-block;\r\n  width: 2px;\r\n  height: 1em;\r\n  background: var(--mn-accent);\r\n  margin-left: 2px;\r\n  vertical-align: text-bottom;\r\n  animation: cursor-blink 0.8s step-end infinite;\r\n}\r\n\r\n@keyframes cursor-blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }\r\n\r\n@media (prefers-reduced-motion: reduce) {\r\n  .cursor--prose {\r\n    animation: none;\r\n    opacity: 0.85;\r\n  }\r\n}\r\n\r\n/* Stats pill under assistant message */\r\n.msg-stats {\r\n  display: flex;\r\n  gap: 10px;\r\n  flex-wrap: wrap;\r\n  padding: 0 4px;\r\n}\r\n\r\n.stat-chip {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 4px;\r\n  font-size: 9px;\r\n  letter-spacing: .06em;\r\n  padding: 2px 7px;\r\n  border-radius: 2px;\r\n  border: 1px solid var(--mn-border-strong);\r\n  color: var(--mn-fg-subtle);\r\n  white-space: nowrap;\r\n}\r\n\r\n.stat-chip span { font-weight: 700; }\r\n.stat-chip.c { color: var(--mn-accent); border-color: color-mix(in srgb, var(--mn-accent) 35%, transparent); }\r\n.stat-chip.g { color: var(--mn-success); border-color: color-mix(in srgb, var(--mn-success) 35%, transparent); }\r\n.stat-chip.y { color: var(--mn-warning); border-color: color-mix(in srgb, var(--mn-warning) 35%, transparent); }\r\n.stat-chip.r { color: var(--mn-danger); border-color: color-mix(in srgb, var(--mn-danger) 35%, transparent); }\r\n/* llama.cpp-only chips: prompt-processing rate and speculative-draft acceptance. */\r\n.stat-chip.b { color: var(--mn-fg-muted); border-color: color-mix(in srgb, var(--mn-fg-muted) 35%, transparent); }\r\n.stat-chip.p { color: var(--mn-accent-ink); border-color: color-mix(in srgb, var(--mn-accent-ink) 35%, transparent); }\r\n\r\n/* ── Tool call rows ────────────────────────────────────────────────────────\r\n   A transcript can hold hundreds of these, so a settled call is one quiet line:\r\n   glyph · action · target · outcome. Colour is reserved for failure. */\r\n\r\n.tool-call-msg {\r\n  align-self: flex-start;\r\n  /* Fixed, not shrink-to-fit: consecutive calls must line up as a column. */\r\n  width: min(var(--chat-tool-call-max), 100%);\r\n  animation: fadeUp 0.22s var(--ease-out);\r\n}\r\n\r\n.tool-call-details {\r\n  border-radius: var(--radius-sm);\r\n  border: 1px solid color-mix(in srgb, var(--mn-border) 80%, transparent);\r\n  background: var(--mn-surface-1);\r\n  font-size: 13px;\r\n  color: var(--mn-fg);\r\n}\r\n\r\n.tool-call-details[open] {\r\n  border-color: var(--mn-border);\r\n}\r\n\r\n.tool-call-summary {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  min-height: 32px;\r\n  padding: 5px 8px 5px 9px;\r\n  border-radius: inherit;\r\n  cursor: pointer;\r\n  list-style: none;\r\n  user-select: none;\r\n  transition: background-color 0.15s var(--ease-out);\r\n}\r\n\r\n.tool-call-summary::-webkit-details-marker { display: none; }\r\n.tool-call-summary::marker { content: ''; }\r\n\r\n@media (hover: hover) and (pointer: fine) {\r\n  .tool-call-summary:hover {\r\n    background: color-mix(in srgb, var(--mn-fg) 5%, transparent);\r\n  }\r\n}\r\n\r\n.tool-call-summary:focus-visible {\r\n  outline: 2px solid var(--mn-accent);\r\n  outline-offset: 1px;\r\n}\r\n\r\n/* Glyph slot: spinner while running, the tool's own icon once settled. */\r\n.tool-call-status {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  flex-shrink: 0;\r\n  width: 16px;\r\n  height: 16px;\r\n}\r\n\r\n.tool-call-icon {\r\n  color: var(--mn-fg-muted);\r\n}\r\n\r\n.tool-call-status--fail .tool-call-icon {\r\n  color: var(--mn-danger);\r\n}\r\n\r\n.tool-call-action {\r\n  flex-shrink: 0;\r\n  font-family: var(--font-ui);\r\n  font-size: 13px;\r\n  font-weight: 600;\r\n  letter-spacing: -0.01em;\r\n  line-height: 1.3;\r\n  color: var(--mn-fg);\r\n  white-space: nowrap;\r\n}\r\n\r\n.tool-call-target {\r\n  flex: 1 1 auto;\r\n  min-width: 0;\r\n  font-family: var(--font-ui);\r\n  font-size: 13px;\r\n  line-height: 1.3;\r\n  color: var(--mn-fg-muted);\r\n  white-space: nowrap;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n}\r\n\r\n.tool-call-target--code,\r\n.tool-call-target--path {\r\n  font-family: var(--font-mono);\r\n  font-size: 12px;\r\n}\r\n\r\n/* Paths ellipsize in the middle so the file name always survives. */\r\n.tool-call-target--path {\r\n  display: flex;\r\n  align-items: baseline;\r\n}\r\n\r\n.tool-call-target__dir {\r\n  min-width: 0;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n  color: var(--mn-fg-muted);\r\n}\r\n\r\n/* The basename is what people scan for, so it is the brightest part of the path. */\r\n.tool-call-target__base {\r\n  flex-shrink: 0;\r\n  color: var(--mn-fg);\r\n}\r\n\r\n.tool-call-target--file-link {\r\n  pointer-events: auto;\r\n  cursor: pointer;\r\n  border: none;\r\n  background: transparent;\r\n  padding: 0;\r\n  text-align: left;\r\n  font-family: var(--font-mono);\r\n  font-size: 12px;\r\n  color: var(--mn-fg);\r\n}\r\n\r\n.tool-call-target--file-link:hover {\r\n  color: var(--mn-accent);\r\n  text-decoration: underline;\r\n}\r\n\r\n.tool-call-target--file-link:focus-visible {\r\n  outline: 2px solid var(--mn-accent);\r\n  outline-offset: 2px;\r\n  border-radius: 3px;\r\n}\r\n\r\n/* Outcome: the measurement this tool produced. Reads as a bench gauge. */\r\n.tool-call-outcome {\r\n  display: inline-flex;\r\n  align-items: baseline;\r\n  gap: 6px;\r\n  flex-shrink: 0;\r\n  margin-left: auto;\r\n  font-family: var(--font-mono);\r\n  font-size: 11px;\r\n  font-variant-numeric: tabular-nums;\r\n  /* Measurement, not decoration: stays above the AA floor in every palette. */\r\n  color: var(--mn-fg-muted);\r\n  white-space: nowrap;\r\n}\r\n\r\n.tool-call-outcome--danger {\r\n  color: var(--mn-danger-ink, var(--mn-danger));\r\n}\r\n\r\n.tool-call-sandbox-badge {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  font-family: var(--font-mono);\r\n  font-size: 10px;\r\n  letter-spacing: 0.02em;\r\n  padding: 1px 6px;\r\n  border-radius: 3px;\r\n  border: 1px solid var(--mn-border);\r\n  color: var(--mn-fg-muted);\r\n  background: var(--mn-surface-2, var(--mn-surface));\r\n}\r\n\r\n.tool-call-sandbox-badge--ok {\r\n  color: var(--mn-success-ink, var(--mn-fg-muted));\r