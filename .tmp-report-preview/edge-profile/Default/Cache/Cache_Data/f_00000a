const __vite__css = "/* Minnow — design tokens aliased to Minnow --mn-* palette (see tokens.css). */\r\n\r\n/* Core OS tokens on :root so OS chrome renders outside the desktop shell. */\r\n:root,\r\n.mn-os {\r\n  /* core aliases */\r\n  --os-bg: var(--mn-bg);\r\n  --os-surface-0: var(--mn-surface-0);\r\n  --os-surface-1: var(--mn-surface-1);\r\n  --os-surface-2: var(--mn-surface-2);\r\n  --os-surface-3: color-mix(in srgb, var(--mn-surface-2) 72%, var(--mn-bg) 28%);\r\n  --os-raise: var(--mn-surface-elevated);\r\n\r\n  --os-text: var(--mn-fg);\r\n  --os-text-dim: var(--mn-fg-muted);\r\n  --os-text-faint: var(--mn-fg-subtle);\r\n\r\n  --os-border: var(--mn-border);\r\n  --os-border-strong: var(--mn-border-strong);\r\n\r\n  --os-accent: var(--mn-accent);\r\n  --os-accent-2: var(--mn-accent-ink);\r\n  --os-on-accent: var(--mn-fg-on-accent);\r\n  --os-accent-soft: var(--mn-accent-soft);\r\n  --os-accent-glow: var(--mn-accent-border);\r\n\r\n  --os-menubar-h: 46px;\r\n  /* Desktop window chrome — smaller than --touch-min (mobile composer targets). */\r\n  --os-window-btn-size: 32px;\r\n  --os-window-btn-icon-size: 12px;\r\n\r\n  /* motion + radii (prototype values, aligned where Minnow matches) */\r\n  --os-ease: cubic-bezier(0.2, 0.7, 0.2, 1);\r\n  --os-ease-out: var(--ease-out);\r\n  --os-r-sm: var(--radius-sm);\r\n  --os-r-md: 9px;\r\n  --os-r-lg: var(--radius-lg);\r\n  --os-r-xl: 20px;\r\n}\r\n\r\n.mn-os {\r\n  color: var(--os-text);\r\n}\r\n\r\n/* ============================================================\r\n   Minnow — shell, menubar, stage, transitions\r\n   ============================================================ */\r\n\r\n.mn-os {\r\n  /* dvh tracks the visible viewport on iOS Safari (address bar / home indicator). */\r\n  height: 100dvh;\r\n  display: flex;\r\n  flex-direction: column;\r\n  overflow: hidden;\r\n  position: relative;\r\n  background: var(--os-bg);\r\n  font-family: var(--font-ui);\r\n  -webkit-font-smoothing: antialiased;\r\n  text-rendering: optimizeLegibility;\r\n}\r\n\r\n/* optimizeLegibility enables CoreText ligatures; that lags composer glyph paint. */\r\n.mn-os textarea,\r\n.mn-os input:not([type='checkbox']):not([type='radio']):not([type='range']):not([type='color']):not([type='file']) {\r\n  text-rendering: auto;\r\n  font-variant-ligatures: none;\r\n}\r\n\r\n/* Shared OS safe-area + dock reveal metrics (chat app + desktop composer reserve). */\r\nhtml.minnow-os-enabled {\r\n  --os-safe-bottom: env(safe-area-inset-bottom, 0px);\r\n  --os-dock-reveal-height: 22px;\r\n  /* #osDockLayer is a stage sibling of #osDesktopLayer — inherit inset here, not only on the desktop layer. */\r\n  --os-dock-panel-inset: var(--os-dock-reveal-height);\r\n}\r\n\r\n@media (pointer: coarse) {\r\n  html.minnow-os-enabled {\r\n    --os-dock-reveal-height: var(--touch-min);\r\n  }\r\n}\r\n\r\n#osDockLayer {\r\n  position: absolute;\r\n  inset: 0;\r\n  /* Below floating windows (15) and side panels (25). */\r\n  z-index: 12;\r\n  pointer-events: none;\r\n}\r\n\r\n/* ---------- menubar ---------- */\r\n\r\n.mn-os-menubar {\r\n  height: var(--os-menubar-h);\r\n  flex: none;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 8px;\r\n  padding: 0 14px;\r\n  background: var(--os-surface-1);\r\n  border-bottom: 1px solid var(--os-border);\r\n  position: relative;\r\n  z-index: 40;\r\n  /* Let icon focus rings / open glows paint outside the 46px bar. */\r\n  overflow: visible;\r\n}\r\n\r\n.mn-os-mb-left,\r\n.mn-os-mb-right {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n  min-width: 0;\r\n}\r\n\r\n.mn-os-mb-left {\r\n  flex: 0 1 auto;\r\n  /* Clip long status text when the left cluster shrinks. */\r\n  overflow: hidden;\r\n  /* Room for :focus-visible outlines on left-cluster controls. */\r\n  padding: 3px;\r\n  margin: -3px;\r\n}\r\n\r\n.mn-os-mb-right {\r\n  flex: 1 1 0;\r\n  justify-content: flex-end;\r\n  overflow: visible;\r\n}\r\n\r\n.mn-os-mb-workspace-slot {\r\n  min-width: 0;\r\n  transition:\r\n    opacity 0.18s var(--ease-out),\r\n    visibility 0.18s var(--ease-out),\r\n    max-width 0.22s var(--ease-out),\r\n    flex-basis 0.22s var(--ease-out);\r\n}\r\n\r\n.mn-os-mb-workspace-slot[hidden] {\r\n  display: none !important;\r\n}\r\n\r\n/* Workspace picker in the menubar left cluster (replaces former app switcher) */\r\n.mn-os-mb-left .mn-os-mb-workspace-slot .workspace-control {\r\n  max-width: min(14rem, 32vw);\r\n}\r\n\r\n.mn-os-mb-left .mn-os-mb-workspace-slot .workspace-path-label {\r\n  font-size: 13px;\r\n  font-weight: 500;\r\n  color: var(--os-text);\r\n}\r\n\r\n.mn-os-mb-right .mn-os-mb-workspace-slot .workspace-control {\r\n  max-width: min(18rem, 28vw);\r\n}\r\n\r\n.mn-os-mb-right .mn-os-mb-workspace-slot .workspace-path-label {\r\n  font-size: 12px;\r\n}\r\n\r\n/* Match menubar bell / settings icon chrome (32px ghost tile) */\r\n.mn-os-mb-workspace-slot .workspace-btn.icon-btn {\r\n  position: relative;\r\n  width: 32px;\r\n  height: 32px;\r\n  display: grid;\r\n  place-items: center;\r\n  background: transparent;\r\n  border: 1px solid transparent;\r\n  border-radius: 8px;\r\n  color: var(--os-text-dim);\r\n  transition: 0.14s var(--os-ease);\r\n}\r\n\r\n.mn-os-mb-workspace-slot .workspace-btn.icon-btn:hover {\r\n  background: var(--os-surface-2);\r\n  border-color: transparent;\r\n  color: var(--os-text);\r\n}\r\n\r\n.mn-os-mb-workspace-slot .workspace-btn.icon-btn:active {\r\n  background: var(--os-surface-2);\r\n}\r\n\r\n.mn-os-mb-workspace-slot .workspace-btn.icon-btn[aria-expanded='true'] {\r\n  background: var(--os-surface-2);\r\n  color: var(--os-text);\r\n  box-shadow: 0 0 0 2px var(--os-accent-glow);\r\n}\r\n\r\n.mn-os-mb-workspace-slot .workspace-btn .icon-svg {\r\n  --mn-icon-size: 16px;\r\n}\r\n\r\n.mn-os-mb-logo {\r\n  flex-shrink: 0;\r\n  width: 30px;\r\n  height: 30px;\r\n  border-radius: 8px;\r\n  display: grid;\r\n  place-items: center;\r\n  background: var(--os-accent);\r\n  color: var(--os-on-accent);\r\n  box-shadow:\r\n    0 0 0 1px var(--os-accent-glow),\r\n    0 4px 14px -4px var(--os-accent-glow);\r\n}\r\n\r\n.mn-os-mb-logo .minnow-glyph {\r\n  width: 18px;\r\n  height: 18px;\r\n}\r\n\r\n.mn-os-mb-brand {\r\n  font-weight: 600;\r\n  letter-spacing: -0.01em;\r\n  font-size: 15px;\r\n}\r\n\r\n/* `display: grid` / flex on buttons can override the native [hidden] rule — hide via view + attribute */\r\n.mn-os-menubar[data-view='desktop'] .mn-os-mb-app-sep,\r\n.mn-os-menubar[data-view='desktop'] .mn-os-mb-appname,\r\n.mn-os-mb-app-sep[hidden],\r\n.mn-os-mb-appname[hidden] {\r\n  display: none !important;\r\n}\r\n\r\n.mn-os-menubar[data-view='app'] .mn-os-mb-brand,\r\n.mn-os-mb-brand[hidden] {\r\n  display: none !important;\r\n}\r\n\r\n.mn-os-mb-sep {\r\n  width: 1px;\r\n  height: 18px;\r\n  background: var(--os-border-strong);\r\n}\r\n\r\n.mn-os-mb-appname {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 7px;\r\n  flex-shrink: 0;\r\n  font-size: 13px;\r\n  color: var(--os-text-dim);\r\n}\r\n\r\n.mn-os-mb-appname .icon-svg {\r\n  --mn-icon-size: 14px;\r\n}\r\n\r\n/* Operational status (Ready, loading models, errors) — mirrors legacy .status-pill */\r\n.mn-os-mb-status.status-pill {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  flex-shrink: 0;\r\n  font-size: 12px;\r\n  color: var(--os-text-dim);\r\n  white-space: nowrap;\r\n}\r\n\r\n.mn-os-mb-status #osStatusText {\r\n  overflow: visible;\r\n  user-select: text;\r\n  -webkit-user-select: text;\r\n}\r\n\r\n/* Error status: click copies the full message (see setStatus in status.ts). */\r\n.mn-os-mb-status #osStatusText.status-pill__text--copyable,\r\n.status-pill #sText.status-pill__text--copyable {\r\n  cursor: copy;\r\n}\r\n\r\n/* Shared spinner markup from model-load-unload-button.ts */\r\n.model-load-unload-spinner {\r\n  flex-shrink: 0;\r\n  width: 14px;\r\n  height: 14px;\r\n  border: 2px solid var(--mn-border-strong);\r\n  border-top-color: var(--mn-accent);\r\n  border-radius: 50%;\r\n  animation: model-load-unload-spin 0.65s linear infinite;\r\n}\r\n\r\n@keyframes model-load-unload-spin {\r\n  to { transform: rotate(360deg); }\r\n}\r\n\r\n@media (prefers-reduced-motion: reduce) {\r\n  .model-load-unload-spinner {\r\n    animation: none;\r\n    border-top-color: var(--mn-accent);\r\n    opacity: 0.85;\r\n  }\r\n}\r\n\r\n.mn-os-mb-icon,\r\n.mn-os-mb-bell,\r\n.mn-os-mb-agents {\r\n  position: relative;\r\n  flex-shrink: 0;\r\n  width: 32px;\r\n  height: 32px;\r\n  display: grid;\r\n  place-items: center;\r\n  background: transparent;\r\n  border: 1px solid transparent;\r\n  border-radius: 8px;\r\n  color: var(--os-text-dim);\r\n  transition: 0.14s var(--os-ease);\r\n}\r\n\r\n.mn-os-mb-icon:hover,\r\n.mn-os-mb-bell:hover,\r\n.mn-os-mb-agents:hover {\r\n  background: var(--os-surface-2);\r\n  color: var(--os-text);\r\n}\r\n\r\n.mn-os-mb-bell.is-on {\r\n  color: var(--os-accent);\r\n}\r\n\r\n.mn-os-mb-agents.is-on {\r\n  color: var(--os-accent);\r\n}\r\n\r\n.mn-os-mb-agents.is-open {\r\n  background: var(--os-surface-2);\r\n  color: var(--os-text);\r\n  box-shadow: 0 0 0 2px var(--os-accent-glow);\r\n}\r\n\r\n.mn-os-mb-bell.is-muted {\r\n  color: var(--mn-fg-muted);\r\n}\r\n\r\n.mn-os-mb-bell.is-muted.is-on {\r\n  color: var(--mn-fg-muted);\r\n}\r\n\r\n.mn-os-mb-bell.is-open {\r\n  background: var(--os-surface-2);\r\n  color: var(--os-text);\r\n  box-shadow: 0 0 0 2px var(--os-accent-glow);\r\n}\r\n\r\n.mn-os-mb-bell.is-ringing {\r\n  animation: mn-os-bell-ring 1.2s ease-out;\r\n  transform-origin: top center;\r\n}\r\n\r\n@keyframes mn-os-bell-ring {\r\n  0% { transform: rotate(0deg); }\r\n  12% { transform: rotate(12deg); }\r\n  24% { transform: rotate(-10deg); }\r\n  36% { transform: rotate(8deg); }\r\n  48% { transform: rotate(-6deg); }\r\n  60% { transform: rotate(4deg); }\r\n  72% { transform: rotate(-2deg); }\r\n  100% { transform: rotate(0deg); }\r\n}\r\n\r\n/* Menubar app switcher popover (in-app quick launch) */\r\n.mn-os-app-switcher {\r\n  position: fixed;\r\n  z-index: 55;\r\n  width: min(17.5rem, calc(100vw - 1rem));\r\n  background: var(--mn-bg);\r\n  border: 1px solid var(--mn-border);\r\n  border-radius: var(--radius-sm);\r\n  box-shadow: var(--shadow-popover-soft);\r\n  color: var(--mn-fg);\r\n  overflow: hidden;\r\n}\r\n\r\n.mn-os-app-switcher.hidden {\r\n  display: none;\r\n}\r\n\r\n.mn-os-app-switcher__header {\r\n  padding: 10px 12px 6px;\r\n  border-bottom: 1px solid var(--mn-border);\r\n}\r\n\r\n.mn-os-app-switcher__title {\r\n  font-size: 13px;\r\n  font-weight: 600;\r\n  color: var(--mn-fg);\r\n}\r\n\r\n.mn-os-app-switcher__grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(4, minmax(0, 1fr));\r\n  gap: 4px;\r\n  padding: 10px;\r\n}\r\n\r\n.mn-os-app-switcher__tile {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  gap: 4px;\r\n  min-width: 0;\r\n  padding: 8px 4px 6px;\r\n  background: transparent;\r\n  border: 1px solid transparent;\r\n  border-radius: 8px;\r\n  color: var(--mn-fg-muted);\r\n  transition: background-color 0.14s var(--os-ease), border-color 0.14s var(--os-ease), color 0.14s var(--os-ease);\r\n}\r\n\r\n.mn-os-app-switcher__ico {\r\n  width: 36px;\r\n  height: 36px;\r\n  display: grid;\r\n  place-items: center;\r\n  border-radius: 10px;\r\n  background: var(--os-surface-2);\r\n  border: 1px solid var(--os-border-strong);\r\n  color: var(--os-accent);\r\n  transition: background-color 0.14s var(--os-ease), border-color 0.14s var(--os-ease);\r\n}\r\n\r\n.mn-os-app-switcher__ico .icon-svg {\r\n  --mn-icon-size: 16px;\r\n}\r\n\r\n.mn-os-app-switcher__ico .minnow-glyph {\r\n  width: 17px;\r\n  height: 17px;\r\n}\r\n\r\n.mn-os-app-switcher__name {\r\n  max-width: 100%;\r\n  font-size: 11px;\r\n  line-height: 1.2;\r\n  text-align: center;\r\n  white-space: nowrap;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n}\r\n\r\n.mn-os-app-switcher__tile:hover {\r\n  color: var(--mn-fg);\r\n  background: var(--os-su