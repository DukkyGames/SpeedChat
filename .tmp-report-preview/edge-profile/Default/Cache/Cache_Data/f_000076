function persistRanksAfterReorder(orderedIds, movingIds, insertIndex) {
	const existing = new Map([...orderedIds, ...movingIds].map((id) => [id, findIssueById(id)?.rank]));
	const nextRanks = ranksAfterReorder(orderedIds, existing, movingIds, insertIndex);
	const seen = new Set();
	for (const id of [...orderedIds, ...movingIds]) {
		if (seen.has(id)) continue;
		seen.add(id);
		const rank = nextRanks.get(id);
		if (!rank) continue;
		const isMover = movingIds.includes(id);
		if (isMover) {
			updateIssue(id, { rank });
			continue;
		}
		if (rank !== findIssueById(id)?.rank) updateIssue(id, { rank });
	}
}
