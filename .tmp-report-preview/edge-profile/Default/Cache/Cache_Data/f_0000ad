const __vite__css = "/**\r\n * Research app — library-first workspace.\r\n *\r\n * Rail of runs on the left, one main pane on the right that shows whichever run\r\n * is selected: composer when new, evidence ledger while running, brief when done.\r\n *\r\n * Apps render inside MinnowOS windows, so width rules use @container, never\r\n * @media — a media query measures the viewport and never matches app width.\r\n */\r\n\r\n.research-page {\r\n  display: none;\r\n  flex: 1;\r\n  min-height: 0;\r\n  height: 100%;\r\n  background: var(--mn-bg);\r\n  color: var(--mn-fg);\r\n  font-family: var(--font-ui);\r\n  font-size: 14px;\r\n  line-height: 1.5;\r\n\r\n  container-type: inline-size;\r\n  container-name: research;\r\n}\r\n\r\n.research-page.is-open {\r\n  display: flex;\r\n}\r\n\r\n/*\r\n * Sizing vars live on .rs-shell, one level below the container element, because\r\n * @container rules never match the container itself — declaring them on\r\n * .research-page would make every width override a silent no-op.\r\n */\r\n.rs-shell {\r\n  display: flex;\r\n  flex: 1;\r\n  min-width: 0;\r\n  min-height: 0;\r\n\r\n  --rs-rail-w: 264px;\r\n  --rs-read: 68ch;\r\n  --rs-gutter: 28px;\r\n\r\n  /*\r\n   * One measured page for the whole run view. Header, tabs, brief and ledger\r\n   * all resolve --rs-pad-x against the same containing block, so they share a\r\n   * left and right edge no matter how wide the window gets. Full-bleed rules\r\n   * (the header hairline) still span the pane, because padding never moves the\r\n   * border box.\r\n   */\r\n  /*\r\n   * The two columns are sized directly and the page is their sum, so the\r\n   * header, the tabs and both columns always end on the same right edge.\r\n   * Reading column is set in px, not ch: ch resolves against this element's\r\n   * 14px font, while the prose inside it runs at 16px, so a ch value here\r\n   * would silently mean something else than it says.\r\n   */\r\n  --rs-read-col: 790px;\r\n  --rs-aside-w: 460px;\r\n  --rs-col-gap: 76px;\r\n  --rs-page: calc(var(--rs-read-col) + var(--rs-col-gap) + var(--rs-aside-w));\r\n  --rs-pad-x: max(var(--rs-gutter), (100% - var(--rs-page)) / 2);\r\n}\r\n\r\n/* ── Rail ──────────────────────────────────────────────────────────────────\r\n   Rows, not cards. Full-bleed, hairline-separated, grouped by recency. */\r\n\r\n.rs-rail {\r\n  display: flex;\r\n  flex-direction: column;\r\n  flex: 0 0 var(--rs-rail-w);\r\n  width: var(--rs-rail-w);\r\n  min-width: 0;\r\n  border-right: 1px solid var(--mn-border);\r\n  background: var(--mn-surface-0);\r\n}\r\n\r\n.rs-rail__head {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  padding: 12px 10px 8px 12px;\r\n}\r\n\r\n.rs-new {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  flex: 1;\r\n  min-width: 0;\r\n  padding: 8px 10px;\r\n  border: 1px solid var(--mn-border-strong);\r\n  border-radius: var(--radius-sm);\r\n  background: transparent;\r\n  color: var(--mn-fg);\r\n  font: inherit;\r\n  font-size: 13px;\r\n  font-weight: 500;\r\n  cursor: pointer;\r\n  transition: background var(--duration-fast) var(--ease-out),\r\n    border-color var(--duration-fast) var(--ease-out);\r\n}\r\n\r\n.rs-rail__collapse {\r\n  display: none;\r\n  flex: 0 0 auto;\r\n  width: 30px;\r\n  height: 30px;\r\n  align-items: center;\r\n  justify-content: center;\r\n  border: 0;\r\n  border-radius: var(--radius-sm);\r\n  background: transparent;\r\n  color: var(--mn-fg-muted);\r\n  cursor: pointer;\r\n}\r\n\r\n.rs-rail__filter {\r\n  position: relative;\r\n  display: flex;\r\n  align-items: center;\r\n  padding: 0 12px 10px;\r\n}\r\n\r\n.rs-rail__filter-icon {\r\n  position: absolute;\r\n  left: 21px;\r\n  color: var(--mn-fg-subtle);\r\n  pointer-events: none;\r\n}\r\n\r\n.rs-rail__filter-input {\r\n  width: 100%;\r\n  padding: 6px 8px 6px 26px;\r\n  border: 1px solid var(--mn-border);\r\n  border-radius: var(--radius-sm);\r\n  background: var(--mn-bg);\r\n  color: var(--mn-fg);\r\n  font: inherit;\r\n  font-size: 13px;\r\n}\r\n\r\n.rs-rail__filter-input::placeholder {\r\n  color: var(--mn-fg-subtle);\r\n}\r\n\r\n.rs-rail__filter-input::-webkit-search-cancel-button {\r\n  filter: grayscale(1);\r\n  opacity: 0.5;\r\n}\r\n\r\n.rs-rail__list {\r\n  flex: 1;\r\n  min-height: 0;\r\n  overflow-y: auto;\r\n  overscroll-behavior: contain;\r\n}\r\n\r\n.rs-group__label {\r\n  position: sticky;\r\n  top: 0;\r\n  z-index: 1;\r\n  display: block;\r\n  padding: 10px 14px 5px;\r\n  background: var(--mn-surface-0);\r\n  color: var(--mn-fg-muted);\r\n  font-family: var(--font-mono);\r\n  font-size: 10px;\r\n  font-weight: 600;\r\n  letter-spacing: 0.08em;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.rs-row-wrap {\r\n  position: relative;\r\n}\r\n\r\n.rs-row {\r\n  display: block;\r\n  width: 100%;\r\n  padding: 9px 34px 10px 14px;\r\n  border: 0;\r\n  border-top: 1px solid transparent;\r\n  border-bottom: 1px solid var(--mn-border);\r\n  background: transparent;\r\n  color: inherit;\r\n  font: inherit;\r\n  text-align: left;\r\n  cursor: pointer;\r\n  transition: background var(--duration-fast) var(--ease-out);\r\n}\r\n\r\n.rs-row__title {\r\n  display: -webkit-box;\r\n  -webkit-line-clamp: 2;\r\n  line-clamp: 2;\r\n  -webkit-box-orient: vertical;\r\n  overflow: hidden;\r\n  color: var(--mn-fg);\r\n  font-size: 13.5px;\r\n  font-weight: 500;\r\n  line-height: 1.35;\r\n  overflow-wrap: anywhere;\r\n}\r\n\r\n.rs-row__meta {\r\n  margin-top: 4px;\r\n  color: var(--mn-fg-muted);\r\n  font-family: var(--font-mono);\r\n  font-size: 10.5px;\r\n  letter-spacing: 0.01em;\r\n}\r\n\r\n/* Selected reads as a tint plus weight. No coloured side stripe. */\r\n.rs-row.is-active {\r\n  background: var(--mn-accent-soft);\r\n}\r\n\r\n.rs-row.is-active .rs-row__title {\r\n  font-weight: 600;\r\n}\r\n\r\n.rs-row.is-active .rs-row__meta {\r\n  color: var(--mn-accent-ink);\r\n}\r\n\r\n.rs-row:focus-visible {\r\n  outline: 2px solid var(--mn-focus-ring);\r\n  outline-offset: -2px;\r\n}\r\n\r\n.rs-row__menu {\r\n  position: absolute;\r\n  top: 6px;\r\n  right: 4px;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  width: 26px;\r\n  height: 26px;\r\n  padding: 0;\r\n  border: 0;\r\n  border-radius: var(--radius-sm);\r\n  background: transparent;\r\n  color: var(--mn-fg-subtle);\r\n  cursor: pointer;\r\n  opacity: 0;\r\n  transition: opacity var(--duration-fast) var(--ease-out);\r\n}\r\n\r\n.rs-row-wrap:has(.rs-row.is-active) .rs-row__menu,\r\n.rs-row-wrap:has(.rs-row.is-menu-open) .rs-row__menu,\r\n.rs-row__menu:focus-visible {\r\n  opacity: 1;\r\n}\r\n\r\n/* Run state: colour is never the only signal — every state carries its word. */\r\n.rs-row__state {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 4px;\r\n  margin-right: 6px;\r\n  font-weight: 600;\r\n}\r\n\r\n.rs-row__state::before {\r\n  content: '';\r\n  width: 5px;\r\n  height: 5px;\r\n  border-radius: 50%;\r\n  background: currentcolor;\r\n}\r\n\r\n.rs-row__state.is-running {\r\n  color: var(--mn-accent-ink);\r\n}\r\n\r\n.rs-row__state.is-error {\r\n  color: var(--mn-danger);\r\n}\r\n\r\n.rs-row__state.is-cancelled {\r\n  color: var(--mn-warning);\r\n}\r\n\r\n.rs-row__state.is-running::before {\r\n  animation: rs-breathe 2.4s var(--ease-out) infinite;\r\n}\r\n\r\n@keyframes rs-breathe {\r\n  0%,\r\n  100% {\r\n    opacity: 1;\r\n  }\r\n  50% {\r\n    opacity: 0.35;\r\n  }\r\n}\r\n\r\n.rs-rail__empty {\r\n  padding: 20px 16px;\r\n  color: var(--mn-fg-muted);\r\n  font-size: 12.5px;\r\n  line-height: 1.5;\r\n}\r\n\r\n.rs-rail__foot {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 8px;\r\n  padding: 8px 12px;\r\n  border-top: 1px solid var(--mn-border);\r\n}\r\n\r\n.rs-toggle {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  color: var(--mn-fg-muted);\r\n  font-size: 12px;\r\n  cursor: pointer;\r\n}\r\n\r\n.rs-toggle__input {\r\n  position: absolute;\r\n  width: 1px;\r\n  height: 1px;\r\n  opacity: 0;\r\n  pointer-events: none;\r\n}\r\n\r\n.rs-toggle__box {\r\n  width: 13px;\r\n  height: 13px;\r\n  border: 1px solid var(--mn-border-strong);\r\n  border-radius: 3px;\r\n  background: var(--mn-bg);\r\n  transition: background var(--duration-fast) var(--ease-out),\r\n    border-color var(--duration-fast) var(--ease-out);\r\n}\r\n\r\n.rs-toggle__input:checked + .rs-toggle__box {\r\n  border-color: var(--mn-accent);\r\n  background: var(--mn-accent);\r\n}\r\n\r\n.rs-toggle__input:focus-visible + .rs-toggle__box {\r\n  outline: 2px solid var(--mn-focus-ring);\r\n  outline-offset: 2px;\r\n}\r\n\r\n.rs-foot-link {\r\n  padding: 2px 4px;\r\n  border: 0;\r\n  background: transparent;\r\n  color: var(--mn-fg-muted);\r\n  font: inherit;\r\n  font-size: 12px;\r\n  cursor: pointer;\r\n}\r\n\r\n/* ── Row menu ──────────────────────────────────────────────────────────── */\r\n\r\n.rs-menu {\r\n  position: fixed;\r\n  z-index: 60;\r\n  min-width: 168px;\r\n  padding: 4px;\r\n  border: 1px solid var(--mn-border-strong);\r\n  border-radius: var(--radius-sm);\r\n  background: var(--mn-surface-1);\r\n  box-shadow: var(--shadow-popover);\r\n}\r\n\r\n.rs-menu button {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  width: 100%;\r\n  padding: 7px 9px;\r\n  border: 0;\r\n  border-radius: 4px;\r\n  background: transparent;\r\n  color: var(--mn-fg);\r\n  font: inherit;\r\n  font-size: 13px;\r\n  text-align: left;\r\n  cursor: pointer;\r\n}\r\n\r\n.rs-menu button.is-danger {\r\n  color: var(--mn-danger);\r\n}\r\n\r\n.rs-menu__sep {\r\n  height: 1px;\r\n  margin: 4px 2px;\r\n  background: var(--mn-border);\r\n}\r\n\r\n/* ── Main pane ─────────────────────────────────────────────────────────── */\r\n\r\n.rs-main {\r\n  display: flex;\r\n  flex-direction: column;\r\n  flex: 1;\r\n  min-width: 0;\r\n  min-height: 0;\r\n}\r\n\r\n.rs-pane {\r\n  display: flex;\r\n  flex-direction: column;\r\n  flex: 1;\r\n  min-height: 0;\r\n}\r\n\r\n.rs-pane[hidden] {\r\n  display: none;\r\n}\r\n\r\n/* ── Ask pane ──────────────────────────────────────────────────────────── */\r\n\r\n.rs-pane--ask {\r\n  overflow-y: auto;\r\n  justify-content: center;\r\n  padding: 32px var(--rs-gutter);\r\n}\r\n\r\n.rs-ask {\r\n  width: 100%;\r\n  max-width: 640px;\r\n  margin: 0 auto;\r\n}\r\n\r\n.rs-ask__title {\r\n  margin: 0;\r\n  color: var(--mn-fg);\r\n  font-size: 25px;\r\n  font-weight: 600;\r\n  letter-spacing: -0.02em;\r\n  line-height: 1.2;\r\n}\r\n\r\n.rs-ask__sub {\r\n  max-width: 52ch;\r\n  margin: 8px 0 22px;\r\n  color: var(--mn-fg-muted);\r\n  font-size: 14px;\r\n}\r\n\r\n.rs-composer {\r\n  border: 1px solid var(--mn-border-strong);\r\n  border-radius: var(--radius-md);\r\n  background: var(--mn-surface-0);\r\n  transition: border-color var(--duration-fast) var(--ease-out);\r\n}\r\n\r\n.rs-composer:focus-within {\r\n  border-color: var(--mn-accent);\r\n}\r\n\r\n.rs-composer__field {\r\n  display: block;\r\n  width: 100%;\r\n  min-height: 76px;\r\n  max-height: 320px;\r\n  padding: 13px 14px 6px;\r\n  border: 0;\r\n  background: transparent;\r\n  color: var(--mn-fg);\r\n  font: inherit;\r\n  font-size: 15px;\r\n  line-height: 1.5;\r\n  resize: none;\r\n}\r\n\r\n.rs-composer__field:focus {\r\n  outline: none;\r\n}\r\n\r\n.rs-composer__field::placeholder {\r\n  color: var(--mn-fg-subtle);\r\n}\r\n\r\n.rs-composer__field:disabled {\r\n  color: var(--mn-fg-muted);\r\n  cursor: not-allowed;\r\n}\r\n\r\n.rs-composer__bar {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  padding: 8px 8px 8px 10px;\r\n}\r\n\r\n.rs-composer__spacer {\r\n  flex: 1;\r\n}\r\n\r\n.rs-composer__model {\r\n  flex: 0 1 auto;\r\n  min-width: 0;\r\n  max-width: min(220px, 42%);\r\n}\r\n\r\n.rs-composer__model .composer-model-trigger-wrap {\r\n  display: block;\r\n  width: 100%;\r\n  max-width: none;\r\n}\r\n\r\n.rs-composer__model .composer-model-trigger {\r\n  width: 100%;\r\n  max-width: none;\r\n  justify-content: flex-start;\r\n  height: 27px;\r\n  padding: 0 8px;\r\n  border: 1px solid var(--mn-border);\r\n  border-radius: 999px;\r\n  background: transparent;\r\n  font-size: 12px;\r\n}\r\n\r\n.rs-composer__model .composer-model-trigger__label {\r\n  flex: 1;\r\n  min-width: 0;\r\n  text-align: left;\r\n}\r\n\r\n/* ── Option chips ──────────────────────────────────────────────────────── */\r\n\r\n.rs-opts {\r\n  display: flex;\r\n  align-items: center;\r\n  flex-wrap: wrap;\r\n  gap: 5px;\r\n  min-width: 0;\r\n}\r\n\r\n.rs-opt {\r\n  position: relative;\r\n}\r\n\r\n.rs-chip {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 4px;\r\n  height: 27px;\r\n  padding: 0 6px 0 8px;\r\n  border: 1px solid var(--mn-border);\r\n  border-radius: 999px;\r\n  background: transparent;\r\n  color: var(--mn-fg-muted);\r\n  font: inherit;\r\n  font-size: 12px;\r\n  white-space: nowrap;\r\n  cursor: pointer;\r\n  transition: color var(--duration-fast) var(--ease-out),\r\n    border-color var(--duration-fast) var(--ease-out);\r\n}\r\n\r\n.rs-chip--icon {\r\n  padding: 0 7px;\r\n}\r\n\r\n.rs-chip__caret {\r\n  color: var(--mn-fg-subtle);\r\n}\r\n\r\n.rs-chip[aria-expanded='true'],\r\n.rs-chip.is-set {\r\n  border-color: var(--mn-accent-border);\r\n  color: var(--mn-fg);\r\n}\r\n\r\n.rs-chip__dot {\r\n  width: 5px;\r\n  height: 5px;\r\n  border-radius: 50%;\r\n  background: var(--mn-accent);\r\n}\r\n\r\n.rs-chip__dot[hidden] {\r\n  display: none;\r\n}\r\n\r\n.rs-chip:disabled {\r\n  opacity: 0.5;\r\n  cursor: not-allowed;\r\n}\r\n\r\n.rs-pop {\r\n  position: absolute;\r\n  bottom: calc(100% + 6px);\r\n  left: 0;\r\n  z-index: 40;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 12px;\r\n  width: 244px;\r\n  padding: 12px;\r\n  border: 1px solid var(--mn-border-strong);\r\n  border-radius: var(--radius-md);\r\n  background: var(--mn-surface-1);\r\n  box-shadow: var(--shadow-popover);\r\n}\r\n\r\n.rs-pop--wide {\r\n  width: 272px;\r\n}\r\n\r\n.rs-pop[hidden] {\r\n  display: none;\r\n}\r\n\r\n.rs-field {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 5px;\r\n}\r\n\r\n.rs-field[hidden] {\r\n  display: none;\r\n}\r\n\r\n.rs-field__label {\r\n  color: var(--mn-fg-muted);\r\n  font-family: var(--font-mono);\r\n  font-size: 10px;\r\n  font-weight: 600;\r\n  letter-spacing: 0.06em;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.rs-field__hint {\r\n  color: var(--mn-fg-muted);\r\n  font-size: 11.5px;\r\n  line-height: 1.4;\r\n}\r\n\r\n.rs-field__row {\r\n  display: flex;\r\n  gap: 6px;\r\n}\r\n\r\n.rs-field__row .rs-select {\r\n  flex: 1;\r\n  min-width: 0;\r\n}\r\n\r\n.rs-field__btn {\r\n  flex: 0 0 auto;\r\n  padding: 0 10px;\r\n  border: 1px solid var(--mn-border-strong);\r\n  border-radius: var(--radius-sm);\r\n  background: transparent;\r\n  color: var(--mn-fg);\r\n  font: inherit;\r\n  font-size: 12px;\r\n  cursor: pointer;\r\n}\r\n\r\n.rs-field__btn--ghost {\r\n  align-self: flex-start;\r\n  margin-top: 2px;\r\n  height: 26px;\r\n}\r\n\r\n.rs-model-anchor {\r\n  display: block;\r\n  width: 100%;\r\n}\r\n\r\n.rs-model-anchor .composer-model-trigger-wrap {\r\n  display: block;\r\n  width: 100%;\r\n  max-width: none;\r\n}\r\n\r\n.rs-model-anchor .composer-model-trigger {\r\n  width: 100%;\r\n  max-width: none;\r\n  justify-content: flex-start;\r\n  height: 30px;\r\n  padding: 0 8px;\r\n  border: 1px solid var(--mn-border);\r\n  border-radius: var(--radius-sm);\r\n  background: var(--mn-bg);\r\n  font-size: 13px;\r\n}\r\n\r\n.rs-model-anchor .composer-model-trigger__label {\r\n  flex: 1;\r\n  min-width: 0;\r\n  text-align: left;\r\n}\r\n\r\n.rs-select {\r\n  position: relative;\r\n  display: flex;\r\n}\r\n\r\n.rs-select::after {\r\n  content: '';\r\n  position: absolute;\r\n  top: 50%;\r\n  right: 9px;\r\n  width: 6px;\r\n  height: 6px;\r\n  border-right: 1px solid var(--mn-fg-subtle);\r\n  border-bottom: 1px solid var(--mn-fg-subtle);\r\n  transform: translateY(-70%) rotate(45deg);\r\n  pointer-events: none;\r\n}\r\n\r\n.rs-select select,\r\n.rs-input {\r\n  width: 100%;\r\n  height: 30px;\r\n  padding: 0 24px 0 8px;\r\n  border: 1px solid var(--mn-border);\r\n  border-radius: var(--radius-sm);\r\n  background: var(--mn-bg);\r\n  color: var(--mn-fg);\r\n  font: inherit;\r\n  font-size: 13px;\r\n  appearance: none;\r\n}\r\n\r\n.rs-input {\r\n  padding-right: 8px;\r\n}\r\n\r\n.rs-select select:focus-visible,\r\n.rs-input:focus-visible,\r\n.rs-rail__filter-input:focus-visible {\r\n  outline: 2px solid var(--mn-focus-ring);\r\n  outline-offset: -1px;\r\n}\r\n\r\n/* ── Send / stop ───────────────────────────────────────────────────────── */\r\n\r\n.rs-send {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  flex: 0 0 auto;\r\n  width: 32px;\r\n  height: 32px;\r\n  border: 0;\r\n  border-radius: var(--radius-sm);\r\n  background: var(--mn-accent);\r\n  color: var(--mn-fg-on-accent);\r\n  cursor: pointer;\r\n  transition: opacity var(--duration-fast) var(--ease-out);\r\n}\r\n\r\n.rs-send:disabled {\r\n  cursor: default;\r\n  opacity: 0.75;\r\n}\r\n\r\n.rs-cancel {\r\n  padding: 0 11px;\r\n  height: 30px;\r\n  border: 1px solid var(--mn-border-strong);\r\n  border-radius: var(--radius-sm);\r\n  background: transparent;\r\n  color: var(--mn-fg);\r\n  font: inherit;\r\n  font-size: 12.5px;\r\n  cursor: pointer;\r\n}\r\n\r\n.rs-cancel[hidden] {\r\n  display: none;\r\n}\r\n\r\n.rs-spinner {\r\n  width: 14px;\r\n  height: 14px;\r\n  border: 2px solid color-mix(in srgb, currentcolor 28%, transparent);\r\n  border-top-color: currentcolor;\r\n  border-radius: 50%;\r\n  animation: rs-spin 0.7s linear infinite;\r\n}\r\n\r\n.rs-spinner--sm {\r\n  width: 10px;\r\n  height: 10px;\r\n  border-width: 1.5px;\r\n}\r\n\r\n@keyframes rs-spin {\r\n  to {\r\n    transform: rotate(360deg);\r\n  }\r\n}\r\n\r\n/* ── Seeds ─────────────────────────────────────────────────────────────── */\r\n\r\n.rs-seeds {\r\n  display: flex;\r\n  align-items: baseline;\r\n  flex-wrap: wrap;\r\n  gap: 4px 10px;\r\n  margin-top: 16px;\r\n  color: var(--mn-fg-muted);\r\n  font-size: 13px;\r\n}\r\n\r\n.rs-seeds__label {\r\n  font-family: var(--font-mono);\r\n  font-size: 10px;\r\n  font-weight: 600;\r\n  letter-spacing: 0.08em;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.rs-seed {\r\n  padding: 0;\r\n  border: 0;\r\n  border-bottom: 1px solid var(--mn-border-strong);\r\n  background: transparent;\r\n  color: var(--mn-fg-muted);\r\n  font: inherit;\r\n  font-size: 13px;\r\n  cursor: pointer;\r\n  transition: color var(--duration-fast) var(--ease-out),\r\n    border-color var(--duration-fast) var(--ease-out);\r\n}\r\n\r\n/* ── Run pane header ───────────────────────────────────────────────────── */\r\n\r\n/*\r\n * The header scrolls with the brief and pins at the top. Living inside the\r\n * scroll container is also what keeps it aligned: it resolves --rs-pad-x\r\n * against the same content box as the columns below, scrollbar included.\r\n */\r\n.rs-runhead {\r\n  position: sticky;\r\n  top: 0;\r\n  z-index: 5;\r\n  padding: 20px var(--rs-pad-x) 0;\r\n  border-bottom: 1px solid var(--mn-border);\r\n  background: var(--mn-bg);\r\n}\r\n\r\n.rs-runhead__top {\r\n  display: flex;\r\n  align-items: flex-start;\r\n  gap: 16px;\r\n}\r\n\r\n.rs-runhead__ask {\r\n  flex: 1;\r\n  min-width: 0;\r\n}\r\n\r\n/*\r\n * The question is the run's identity, so it is never truncated away — it is\r\n * folded to two lines and unfolds in place. A research prompt is often a\r\n * paragraph, and a paragraph set as a heading is not a heading.\r\n */\r\n.rs-runhead__title {\r\n  display: -webkit-box;\r\n  -webkit-line-clamp: 2;\r\n  line-clamp: 2;\r\n  -webkit-box-orient: vertical;\r\n  overflow: hidden;\r\n  margin: 0;\r\n  color: var(--mn-fg);\r\n  font-size: 19px;\r\n  font-weight: 600;\r\n  letter-spacing: -0.015em;\r\n  line-height: 1.3;\r\n  overflow-wrap: anywhere;\r\n}\r\n\r\n.rs-runhead__title.is-expanded {\r\n  display: block;\r\n  -webkit-line-clamp: none;\r\n  line-clamp: none;\r\n}\r\n\r\n.rs-runhead__more {\r\n  margin-top: 5px;\r\n  padding: 0;\r\n  border: 0;\r\n  background: transparent;\r\n  color: var(--mn-fg-muted);\r\n  font: inherit;\r\n  font-size: 12px;\r\n  cursor: pointer;\r\n  transition: color var(--duration-fast) var(--ease-out);\r\n}\r\n\r\n.rs-runhead__more[hidden] {\r\n  display: none;\r\n}\r\n\r\n.rs-runhead__actions {\r\n  display: flex;\r\n  flex: 0 0 auto;\r\n  flex-wrap: wrap;\r\n  justify-content: flex-end;\r\n  gap: 4px;\r\n}\r\n\r\n.rs-action {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 5px;\r\n  height: 28px;\r\n  padding: 0 9px;\r\n  border: 1px solid var(--mn-border);\r\n  border-radius: var(--radius-sm);\r\n  background: transparent;\r\n  color: var(--mn-fg-muted);\r\n  font: inherit;\r\n  font-size: 12.5px;\r\n  white-space: nowrap;\r\n  cursor: pointer;\r\n  transition: color var(--duration-fast) var(--ease-out),\r\n    border-color var(--duration-fast) var(--ease-out);\r\n}\r\n\r\n.rs-runhead__meta {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  margin-top: 7px;\r\n  font-family: var(--font-mono);\r\n  font-size: 11px;\r\n}\r\n\r\n.rs-state {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 5px;\r\n  color: var(--mn-fg-muted);\r\n  font-weight: 600;\r\n  letter-spacing: 0.02em;\r\n  text-transform: lowercase;\r\n}\r\n\r\n.rs-state::before {\r\n  content: '';\r\n  width: 5px;\r\n  height: 5px;\r\n  border-radius: 50%;\r\n  background: currentcolor;\r\n}\r\n\r\n.rs-state.is-running {\r\n  color: var(--mn-accent-ink);\r\n}\r\n\r\n.rs-state.is-running::before {\r\n  animation: rs-breathe 2.4s var(--ease-out) infinite;\r\n}\r\n\r\n.rs-state.is-done {\r\n  color: var(--mn-success);\r\n}\r\n\r\n.rs-state.is-error {\r\n  color: var(--mn-danger);\r\n}\r\n\r\n.rs-state.is-cancelled {\r\n  color: var(--mn-warning);\r\n}\r\n\r\n.rs-runhead__stats {\r\n  color: var(--mn-fg-muted);\r\n}\r\n\r\n.rs-segments {\r\n  display: flex;\r\n  gap: 2px;\r\n  margin-top: 14px;\r\n}\r\n\r\n.rs-segment {\r\n  position: relative;\r\n  padding: 6px 2px 9px;\r\n  margin-right: 16px;\r\n  border: 0;\r\n  background: transparent;\r\n  color: var(--mn-fg-muted);\r\n  font: inherit;\r\n  font-size: 13px;\r\n  cursor: pointer;\r\n  transition: color var(--duration-fast) var(--ease-out);\r\n}\r\n\r\n.rs-segment::after {\r\n  content: '';\r\n  position: absolute;\r\n  right: 0;\r\n  bottom: -1px;\r\n  left: 0;\r\n  height: 1px;\r\n  background: transparent;\r\n}\r\n\r\n.rs-segment.is-on {\r\n  color: var(--mn-fg);\r\n  font-weight: 500;\r\n}\r\n\r\n.rs-segment.is-on::after {\r\n  background: var(--mn-accent);\r\n}\r\n\r\n.rs-segment__count {\r\n  margin-left: 5px;\r\n  color: var(--mn-fg-muted);\r\n  font-family: var(--font-mono);\r\n  font-size: 10.5px;\r\n}\r\n\r\n.rs-runbody {\r\n  flex: 1;\r\n  min-height: 0;\r\n  overflow-y: auto;\r\n  overscroll-behavior: contain;\r\n  scrollbar-gutter: stable;\r\n}\r\n\r\n.rs-runbody > [hidden] {\r\n  display: none;\r\n}\r\n\r\n/* ── Brief ─────────────────────────────────────────────────────────────── */\r\n\r\n.rs-brief {\r\n  padding: 26px var(--rs-pad-x) 64px;\r\n}\r\n\r\n/*\r\n * Narrow windows stack: read the brief, then the sources. Once there is room\r\n * for both, the sources move beside the findings so a citation number and the\r\n * thing it cites are on screen together.\r\n */\r\n.rs-report {\r\n  display: grid;\r\n  grid-template-columns: minmax(0, 1fr);\r\n}\r\n\r\n.rs-report__main,\r\n.rs-report__aside {\r\n  min-width: 0;\r\n}\r\n\r\n.rs-answer {\r\n  max-width: var(--rs-read);\r\n  margin: 0 0 36px;\r\n  color: var(--mn-fg);\r\n  font-size: 18px;\r\n  line-height: 1.6;\r\n}\r\n\r\n.rs-sec {\r\n  display: flex;\r\n  align-items: baseline;\r\n  gap: 8px;\r\n  margin: 0 0 16px;\r\n  color: var(--mn-fg-muted);\r\n  font-family: var(--font-mono);\r\n  font-size: 10px;\r\n  font-weight: 600;\r\n  letter-spacing: 0.08em;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.rs-sec::after {\r\n  content: '';\r\n  flex: 1;\r\n  height: 1px;\r\n  background: var(--mn-border);\r\n}\r\n\r\n.rs-findings {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 34px;\r\n  max-width: var(--rs-read);\r\n  margin-bottom: 44px;\r\n}\r\n\r\n.rs-finding__claim {\r\n  margin: 0 0 8px;\r\n  color: var(--mn-fg);\r\n  font-size: 18px;\r\n  font-weight: 600;\r\n  letter-spacing: -0.01em;\r\n  line-height: 1.4;\r\n}\r\n\r\n.rs-finding__body {\r\n  margin: 0 0 12px;\r\n  color: var(--mn-fg-muted);\r\n  font-size: 16px;\r\n  line-height: 1.7;\r\n}\r\n\r\n.rs-finding__body:last-child {\r\n  margin-bottom: 0;\r\n}\r\n\r\n/* Engine subheadings inside a finding. Smaller and quieter than the claim so\r\n   the finding still reads as one unit. */\r\n.rs-finding__sub {\r\n  margin: 18px 0 7px;\r\n  color: var(--mn-fg);\r\n  font-size: 13px;\r\n  font-weight: 600;\r\n  letter-spacing: 0.01em;\r\n  line-height: 1.4;\r\n}\r\n\r\n.rs-finding__sub:first-of-type {\r\n  margin-top: 4px;\r\n}\r\n\r\n.rs-finding__list {\r\n  margin: 0 0 12px;\r\n  padding-left: 20px;\r\n  color: var(--mn-fg-muted);\r\n  font-size: 16px;\r\n  line-height: 1.7;\r\n}\r\n\r\n.rs-finding__list li {\r\n  margin-bottom: 5px;\r\n}\r\n\r\n.rs-finding__list li::marker {\r\n  color: var(--mn-fg-subtle);\r\n}\r\n\r\n.rs-link {\r\n  color: var(--mn-fg);\r\n  text-decoration: underline;\r\n  text-decoration-color: color-mix(in srgb, currentcolor 42%, transparent);\r\n  text-underline-offset: 2px;\r\n  transition: text-decoration-color var(--duration-fast) var(--ease-out);\r\n}\r\n\r\n.rs-code {\r\n  padding: 1px 4px;\r\n  border-radius: 3px;\r\n  background: var(--mn-surface-elevated);\r\n  font-family: var(--font-mono);\r\n  font-size: 0.88em;\r\n}\r\n\r\n.rs-cite {\r\n  display: inline-block;\r\n  min-width: 15px;\r\n  margin-left: 2px;\r\n  padding: 0 3px;\r\n  border: 0;\r\n  border-radius: 3px;\r\n  background: var(--mn-accent-soft);\r\n  color: var(--mn-accent-ink);\r\n  font-family: var(--font-mono);\r\n  font-size: 10px;\r\n  font-weight: 600;\r\n  line-height: 15px;\r\n  vertical-align: super;\r\n  cursor: pointer;\r\n  transition: background var(--duration-fast) var(--ease-out);\r\n}\r\n\r\n.rs-cite.is-on {\r\n  background: var(--mn-accent);\r\n  color: var(--mn-fg-on-accent);\r\n}\r\n\r\n/* Inline source reveal — opens under the finding that cited it. */\r\n.rs-citebox {\r\n  margin-top: 10px;\r\n  padding: 10px 12px;\r\n  border: 1px solid var(--mn-border);\r\n  border-radius: var(--radius-sm);\r\n  background: var(--mn-surface-0);\r\n}\r\n\r\n.rs-citebox[hidden] {\r\n  display: none;\r\n}\r\n\r\n.rs-citebox__row {\r\n  display: flex;\r\n  align-items: baseline;\r\n  gap: 8px;\r\n}\r\n\r\n.rs-citebox__n {\r\n  color: var(--mn-fg-muted);\r\n  font-family: var(--font-mono);\r\n  font-size: 10.5px;\r\n}\r\n\r\n.rs-citebox__link {\r\n  color: var(--mn-fg);\r\n  font-size: 13.5px;\r\n  text-decoration: none;\r\n  overflow-wrap: anywhere;\r\n}\r\n\r\n.rs-citebox__host {\r\n  color: var(--mn-fg-muted);\r\n  font-family: var(--font-mono);\r\n  font-size: 10.5px;\r\n  white-space: nowrap;\r\n}\r\n\r\n.rs-citebox__snip {\r\n  margin: 6px 0 0;\r\n  color: var(--mn-fg-muted);\r\n  font-size: 13px;\r\n  line-height: 1.55;\r\n}\r\n\r\n.rs-follow {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: flex-start;\r\n  gap: 2px;\r\n  max-width: var(--rs-read);\r\n  margin-bottom: 40px;\r\n}\r\n\r\n/*\r\n * Follow-ups are questions you can run, not prose. The arrow keeps its own\r\n * column so it stays on the first line however far the question wraps.\r\n */\r\n.rs-follow__item {\r\n  display: grid;\r\n  grid-template-columns: minmax(0, 1fr) 14px;\r\n  align-items: baseline;\r\n  gap: 12px;\r\n  width: 100%;\r\n  padding: 11px 4px;\r\n  border: 0;\r\n  border-bottom: 1px solid var(--mn-border);\r\n  background: transparent;\r\n  color: var(--mn-fg);\r\n  font: inherit;\r\n  font-size: 14px;\r\n  line-height: 1.55;\r\n  text-align: left;\r\n  cursor: pointer;\r\n  transition: color var(--duration-fast) var(--ease-out);\r\n}\r\n\r\n.rs-follow__item::after {\r\n  content: '→';\r\n  color: var(--mn-fg-subtle);\r\n  transition: color var(--duration-fast) var(--ease-out),\r\n    transform var(--duration-fast) var(--ease-out);\r\n}\r\n\r\n/* ── References ────────────────────────────────────────────────────────── */\r\n\r\n.rs-refs {\r\n  max-width: var(--rs-read);\r\n  counter-reset: rs-ref;\r\n}\r\n\r\n/* Host sits under the title rather than beside it: the sources column is\r\n   narrow, and a domain crushed against a wrapped title reads as noise. */\r\n.rs-ref {\r\n  display: grid;\r\n  grid-template-columns: 24px minmax(0, 1fr);\r\n  align-items: baseline;\r\n  gap: 2px 6px;\r\n  padding: 8px 6px 9px 2px;\r\n  border-bottom: 1px solid var(--mn-border);\r\n  border-radius: 4px;\r\n  color: inherit;\r\n  text-decoration: none;\r\n  /* Start margin clears the pinned run header when a citation scrolls here. */\r\n  scroll-margin-block: 168px 24px;\r\n  transition: background var(--duration-fast) var(--ease-out);\r\n}\r\n\r\n.rs-ref__n {\r\n  color: var(--mn-fg-muted);\r\n  font-family: var(--font-mono);\r\n  font-size: 11px;\r\n}\r\n\r\n.rs-ref__title {\r\n  min-width: 0;\r\n  color: var(--mn-fg);\r\n  font-size: 13.5px;\r\n  line-height: 1.4;\r\n  overflow-wrap: anywhere;\r\n}\r\n\r\n.rs-ref__host {\r\n  grid-column: 2;\r\n  color: var(--mn-fg-muted);\r\n  font-family: var(--font-mono);\r\n  font-size: 10.5px;\r\n  overflow-wrap: anywhere;\r\n}\r\n\r\n.rs-ref.is-focus {\r\n  background: var(--mn-accent-soft);\r\n}\r\n\r\n.rs-type {\r\n  display: inline-block;\r\n  padding: 0 5px;\r\n  border: 1px solid var(--mn-border-strong);\r\n  border-radius: 3px;\r\n  color: var(--mn-fg-muted);\r\n  font-family: var(--font-mono);\r\n  font-size: 9.5px;\r\n  font-weight: 600;\r\n  letter-spacing: 0.05em;\r\n  line-height: 15px;\r\n  text-transform: uppercase;\r\n}\r\n\r\n/* ── Evidence ledger ───────────────────────────────────────────────────── */\r\n\r\n.rs-ledger {\r\n  padding: 22px var(--rs-pad-x) 64px;\r\n}\r\n\r\n.rs-ledger__plan {\r\n  max-width: var(--rs-read);\r\n  margin: 0 0 26px;\r\n  padding: 12px 14px;\r\n  border: 1px solid var(--mn-border);\r\n  border-radius: var(--radius-sm);\r\n  background: var(--mn-surface-0);\r\n}\r\n\r\n.rs-ledger__plan-label {\r\n  margin-bottom: 5px;\r\n  color: var(--mn-fg-muted);\r\n  font-family: var(--font-mono);\r\n  font-size: 10px;\r\n  font-weight: 600;\r\n  letter-spacing: 0.08em;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.rs-ledger__plan-text {\r\n  margin: 0;\r\n  color: var(--mn-fg);\r\n  font-size: 14px;\r\n  line-height: 1.6;\r\n  white-space: pre-wrap;\r\n}\r\n\r\n.rs-ledger__list {\r\n  max-width: 82ch;\r\n}\r\n\r\n.rs-round {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n  margin: 22px 0 8px;\r\n  color: var(--mn-fg-muted);\r\n  font-family: var(--font-mono);\r\n  font-size: 10px;\r\n  font-weight: 600;\r\n  letter-spacing: 0.08em;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.rs-round::after {\r\n  content: '';\r\n  flex: 1;\r\n  height: 1px;\r\n  background: var(--mn-border);\r\n}\r\n\r\n.rs-round:first-child {\r\n  margin-top: 0;\r\n}\r\n\r\n.rs-entry {\r\n  display: grid;\r\n  grid-template-columns: 18px 1fr;\r\n  align-items: baseline;\r\n  gap: 10px;\r\n  padding: 4px 0;\r\n  font-size: 13.5px;\r\n  line-height: 1.5;\r\n}\r\n\r\n.rs-entry__mark {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  color: var(--mn-fg-subtle);\r\n  font-family: var(--font-mono);\r\n  font-size: 11px;\r\n}\r\n\r\n.rs-entry__text {\r\n  min-width: 0;\r\n  color: var(--mn-fg-muted);\r\n  overflow-wrap: anywhere;\r\n}\r\n\r\n.rs-entry__host {\r\n  margin-left: 8px;\r\n  color: var(--mn-fg-muted);\r\n  font-family: var(--font-mono);\r\n  font-size: 10.5px;\r\n  white-space: nowrap;\r\n}\r\n\r\n.rs-entry--query .rs-entry__text {\r\n  color: var(--mn-fg-muted);\r\n  font-family: var(--font-mono);\r\n  font-size: 12px;\r\n}\r\n\r\n.rs-entry--source .rs-entry__tex