const __vite__css = "/**\r\n * Orchestrate boards page — library-first twin of Super Plan / Research.\r\n *\r\n * Rail of boards on the left, one main pane on the right: ask/start when idle,\r\n * quiet runhead + kanban when a board is open.\r\n *\r\n * Sibling of super-plan-page.css and research-page.css by design.\r\n */\r\n\r\n/* Edge-to-edge shell; hub no longer centres a 640px marketing column. */\r\n.chat-area.chat-area--orchestrate-hub,\r\n.chat-area.chat-area--orchestrate,\r\n.main-column.main-column--board-view .chat-area,\r\n#chatArea.chat-area:has(.ob-page) {\r\n  display: flex;\r\n  flex-direction: column;\r\n  justify-content: stretch;\r\n  align-items: stretch;\r\n  width: 100%;\r\n  min-width: 0;\r\n  padding: 0;\r\n  gap: 0;\r\n  overflow: hidden;\r\n}\r\n\r\n/* Default .chat-area padding (messages.css) must not inset the shell. */\r\nmain#chatArea.chat-area--orchestrate-hub,\r\nmain#chatArea.chat-area--orchestrate,\r\n.main-column.main-column--board-view main#chatArea.chat-area,\r\nmain#chatArea.chat-area:has(.ob-page) {\r\n  padding: 0;\r\n  gap: 0;\r\n}\r\n\r\n.ob-page {\r\n  display: flex;\r\n  flex: 1;\r\n  min-width: 0;\r\n  min-height: 0;\r\n  width: 100%;\r\n  align-self: stretch;\r\n  height: 100%;\r\n  padding: 0;\r\n  margin: 0;\r\n  background: var(--mn-bg);\r\n  color: var(--mn-fg);\r\n  font-family: var(--font-ui, inherit);\r\n  font-size: 14px;\r\n  line-height: 1.5;\r\n\r\n  container-type: inline-size;\r\n  container-name: orchestrate;\r\n\r\n  --ob-rail-w: 264px;\r\n  --ob-gutter: 28px;\r\n  --ob-read-col: 790px;\r\n}\r\n\r\n/*\r\n * Legacy orchestrate-hub.css / hub.css must not center or pad this surface.\r\n * (Vibe .hub-root adds 16px/24px padding; old .orchestrate-hub-root centered the column.)\r\n */\r\n#orchestrateHub.ob-page,\r\n#orchestrateBoardPage.ob-page,\r\n.ob-page.orchestrate-hub-root,\r\n.ob-page.hub-root {\r\n  align-items: stretch;\r\n  justify-content: flex-start;\r\n  padding: 0;\r\n  max-width: none;\r\n}\r\n\r\n.main-column:has(.chat-area--orchestrate-hub) .stats-strip,\r\n.main-column:has(.chat-area--orchestrate) .stats-strip {\r\n  display: none;\r\n}\r\n\r\n/*\r\n * Board and hub panes have no conversation, so the composer and its companion\r\n * strips stay out of the way. They come back the moment a board chat opens in\r\n * the main pane — an agent that asks a question or a tool that needs approval\r\n * is unusable without them.\r\n *\r\n * `#orchestrateBoardPage` is listed as well as `.chat-area--orchestrate`: the\r\n * overlay class can be stripped while the page is still mounted, which used to\r\n * leave the Code composer sitting under the kanban.\r\n *\r\n * The exclusion keys off `.main-column--board-chat` rather than\r\n * `:not(:has(.ob-chat))`: `:has()` did not reliably re-invalidate when the chat\r\n * host is inserted several levels down, which left the composer hidden.\r\n */\r\n.main-column:has(.chat-area--orchestrate-hub) .input-bar,\r\n.main-column:has(.chat-area--orchestrate-hub) .tool-approval-host,\r\n.main-column:has(.chat-area--orchestrate-hub) .question-host,\r\n.main-column:has(.chat-area--orchestrate-hub) .code-change-strip-wrap,\r\n.main-column:has(.chat-area--orchestrate-hub) .chat-jump-latest,\r\n.main-column:has(.chat-area--orchestrate):not(.main-column--board-chat) .input-bar,\r\n.main-column:has(.chat-area--orchestrate):not(.main-column--board-chat) .tool-approval-host,\r\n.main-column:has(.chat-area--orchestrate):not(.main-column--board-chat) .question-host,\r\n.main-column:has(.chat-area--orchestrate):not(.main-column--board-chat) .code-change-strip-wrap,\r\n.main-column:has(.chat-area--orchestrate):not(.main-column--board-chat) .chat-jump-latest,\r\n.main-column:has(#orchestrateBoardPage):not(.main-column--board-chat) .input-bar,\r\n.main-column:has(#orchestrateBoardPage):not(.main-column--board-chat) .tool-approval-host,\r\n.main-column:has(#orchestrateBoardPage):not(.main-column--board-chat) .question-host,\r\n.main-column:has(#orchestrateBoardPage):not(.main-column--board-chat) .code-change-strip-wrap,\r\n.main-column:has(#orchestrateBoardPage):not(.main-column--board-chat) .chat-jump-latest {\r\n  display: none !important;\r\n}\r\n\r\n/*\r\n * The composer and its strips are `.main-column` rows, so by default they run the\r\n * full width of the window — under the board rail and far wider than the\r\n * transcript they belong to. `syncBoardChatComposerBox` measures the open\r\n * transcript's content box and publishes it here, so the composer sits directly\r\n * beneath the messages instead of spanning the whole bottom edge.\r\n *\r\n * Measured rather than derived from `--ob-rail-w` / `--ob-read-col`: those live\r\n * on `.ob-page` (out of reach from `.main-column`), and the rail overlays rather\r\n * than reserves space once the pane is narrow.\r\n */\r\n.main-column--board-chat .input-bar,\r\n.main-column--board-chat .tool-approval-host,\r\n.main-column--board-chat .question-host {\r\n  box-sizing: border-box;\r\n  margin-left: var(--ob-chat-composer-left, 0px);\r\n  width: var(--ob-chat-composer-width, auto);\r\n  max-width: calc(100% - var(--ob-chat-composer-left, 0px));\r\n}\r\n\r\n/*\r\n * The terminal is the same kind of `#mainColumn` row as the composer, so the\r\n * pinned chats rail (`bottom: 0`) would cover it. Inset to `.ob-main` (not the\r\n * padded transcript) so the dock lines up with the chat pane. Maximized mode\r\n * hides the viewport — and the rail with it — so the dock goes full-column.\r\n */\r\n.main-column.main-column--board-chat:not(.main-column--terminal-maximized) .terminal-panel {\r\n  box-sizing: border-box;\r\n  min-width: 0;\r\n  margin-left: var(--ob-chat-terminal-left, 0px);\r\n  width: var(--ob-chat-terminal-width, auto);\r\n  max-width: calc(100% - var(--ob-chat-terminal-left, 0px));\r\n}\r\n\r\n/* Free-standing over the page: a full-bleed strip would re-draw the edge the\r\n   inset above just removed. The composer keeps its own border. */\r\n.main-column--board-chat .input-bar {\r\n  border-top: 0;\r\n  background: transparent;\r\n  padding-left: 0;\r\n  padding-right: 0;\r\n}\r\n\r\n/*\r\n * Board chat lives in #chatArea (.chat-viewport) but the composer and terminal\r\n * are #mainColumn rows below the viewport — the rail must span the full column\r\n * (composer and terminal only in the main pane). Pin the rail to #mainColumn;\r\n * reserve width on .ob-shell so .ob-main does not sit under the out-of-flow rail.\r\n */\r\n.main-column.main-column--board-chat {\r\n  position: relative;\r\n}\r\n\r\n.main-column.main-column--board-chat > .chat-viewport {\r\n  position: static;\r\n  /* Rail is pinned to #mainColumn; don't clip it with the viewport scrollport. */\r\n  overflow: visible;\r\n}\r\n\r\n.main-column.main-column--board-chat main#chatArea.chat-area--orchestrate {\r\n  overflow: hidden;\r\n}\r\n\r\n.main-column.main-column--board-chat .ob-shell {\r\n  padding-left: var(--ob-rail-w);\r\n  box-sizing: border-box;\r\n}\r\n\r\n.main-column.main-column--board-chat .ob-rail {\r\n  position: absolute;\r\n  top: var(--ob-board-chat-rail-top, 0);\r\n  left: var(--ob-board-chat-rail-left, 0);\r\n  bottom: 0;\r\n  height: auto;\r\n  z-index: 3;\r\n  display: flex;\r\n  flex-direction: column;\r\n  overflow: hidden;\r\n}\r\n\r\n/*\r\n * Sizing vars live on .ob-shell (not .ob-page) so @container overrides apply —\r\n * same rule as Super Plan / Research.\r\n */\r\n.ob-shell {\r\n  display: flex;\r\n  flex: 1;\r\n  width: 100%;\r\n  min-width: 0;\r\n  min-height: 0;\r\n}\r\n\r\n/* ── Rail: rows, not cards ──────────────────────────────────────────────── */\r\n\r\n.ob-rail {\r\n  display: flex;\r\n  flex-direction: column;\r\n  flex: 0 0 var(--ob-rail-w);\r\n  width: var(--ob-rail-w);\r\n  /* Keep the library rail at full width — min-width: 0 let the list pinch in chat view. */\r\n  min-width: var(--ob-rail-w);\r\n  border-right: 1px solid var(--mn-border);\r\n  background: var(--mn-surface-0, var(--mn-bg));\r\n}\r\n\r\n.ob-rail__head {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  padding: 12px 10px 8px 12px;\r\n}\r\n\r\n.ob-new {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 6px;\r\n  flex: 1;\r\n  min-width: 0;\r\n  min-height: 34px;\r\n  padding: 8px 10px;\r\n  border: 1px solid var(--mn-border-strong);\r\n  border-radius: var(--radius-sm);\r\n  background: transparent;\r\n  color: var(--mn-fg);\r\n  font: inherit;\r\n  font-size: 13px;\r\n  font-weight: 500;\r\n  cursor: pointer;\r\n  transition:\r\n    background var(--duration-fast, 0.12s) var(--ease-out),\r\n    border-color var(--duration-fast, 0.12s) var(--ease-out);\r\n}\r\n\r\n.ob-rail__collapse {\r\n  display: none;\r\n  flex: 0 0 auto;\r\n  width: 30px;\r\n  height: 30px;\r\n  align-items: center;\r\n  justify-content: center;\r\n  border: 0;\r\n  border-radius: var(--radius-sm);\r\n  background: transparent;\r\n  color: var(--mn-fg-muted);\r\n  cursor: pointer;\r\n  font-size: 16px;\r\n  line-height: 1;\r\n}\r\n\r\n.ob-rail__filter {\r\n  display: flex;\r\n  align-items: center;\r\n  padding: 0 12px 10px;\r\n}\r\n\r\n.ob-rail__filter-input {\r\n  width: 100%;\r\n  padding: 6px 8px;\r\n  border: 1px solid var(--mn-border);\r\n  border-radius: var(--radius-sm);\r\n  background: var(--mn-bg);\r\n  color: var(--mn-fg);\r\n  font: inherit;\r\n  font-size: 13px;\r\n}\r\n\r\n.ob-rail__filter-input::placeholder {\r\n  color: var(--mn-fg-subtle);\r\n}\r\n\r\n.ob-rail__list {\r\n  flex: 1;\r\n  width: 100%;\r\n  min-width: 0;\r\n  min-height: 0;\r\n  box-sizing: border-box;\r\n  overflow-y: auto;\r\n  overscroll-behavior: contain;\r\n}\r\n\r\n.ob-group__label {\r\n  position: sticky;\r\n  top: 0;\r\n  z-index: 1;\r\n  display: block;\r\n  padding: 10px 14px 5px;\r\n  background: var(--mn-surface-0, var(--mn-bg));\r\n  color: var(--mn-fg-muted);\r\n  font-family: var(--font-mono);\r\n  font-size: 10px;\r\n  font-weight: 600;\r\n  letter-spacing: 0.08em;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.ob-row-wrap {\r\n  position: relative;\r\n}\r\n\r\n.ob-row {\r\n  display: block;\r\n  width: 100%;\r\n  padding: 9px 14px 10px;\r\n  border: 0;\r\n  border-bottom: 1px solid var(--mn-border);\r\n  background: transparent;\r\n  color: inherit;\r\n  font: inherit;\r\n  text-align: left;\r\n  cursor: pointer;\r\n  transition: background var(--duration-fast, 0.12s) var(--ease-out);\r\n}\r\n\r\n.ob-row__title {\r\n  display: -webkit-box;\r\n  -webkit-line-clamp: 2;\r\n  line-clamp: 2;\r\n  -webkit-box-orient: vertical;\r\n  overflow: hidden;\r\n  color: var(--mn-fg);\r\n  font-size: 13.5px;\r\n  font-weight: 500;\r\n  line-height: 1.35;\r\n  overflow-wrap: anywhere;\r\n}\r\n\r\n.ob-row__meta {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 6px;\r\n  margin-top: 4px;\r\n  color: var(--mn-fg-muted);\r\n  font-family: var(--font-mono);\r\n  font-size: 10.5px;\r\n  letter-spacing: 0.01em;\r\n}\r\n\r\n/*\r\n * Live-run marker on a board row. Deliberately static: a running CSS animation\r\n * pins the compositor at refresh rate, and this dot is only ever on screen while\r\n * a board (often a local model) is doing work.\r\n */\r\n.ob-row__running-dot {\r\n  display: inline-block;\r\n  width: 7px;\r\n  height: 7px;\r\n  margin-right: 6px;\r\n  border-radius: 50%;\r\n  background: var(--mn-success, var(--success));\r\n  vertical-align: baseline;\r\n}\r\n\r\n.ob-row.is-running .ob-row__title {\r\n  font-weight: 600;\r\n}\r\n\r\n.ob-row.is-active {\r\n  background: var(--mn-accent-soft);\r\n}\r\n\r\n.ob-row.is-active .ob-row__title {\r\n  font-weight: 600;\r\n}\r\n\r\n.ob-row:focus-visible {\r\n  outline: 2px solid var(--mn-focus-ring, var(--mn-accent));\r\n  outline-offset: -2px;\r\n}\r\n\r\n.ob-state {\r\n  display: inline-block;\r\n  color: var(--mn-fg-muted);\r\n  font-family: var(--font-mono);\r\n  font-size: 10px;\r\n  font-weight: 600;\r\n  letter-spacing: 0.04em;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.ob-rail__empty {\r\n  padding: 20px 16px;\r\n  color: var(--mn-fg-muted);\r\n  font-size: 12.5px;\r\n  line-height: 1.5;\r\n}\r\n\r\n.ob-rail__empty-copy {\r\n  margin: 0;\r\n}\r\n\r\n.ob-rail__empty-link {\r\n  display: inline-block;\r\n  margin-top: 10px;\r\n  padding: 2px 0;\r\n  border: 0;\r\n  background: transparent;\r\n  color: var(--mn-fg);\r\n  font: inherit;\r\n  font-size: 12.5px;\r\n  font-weight: 500;\r\n  line-height: 1.4;\r\n  text-align: left;\r\n  text-decoration: underline;\r\n  text-decoration-color: color-mix(in oklch, var(--mn-fg-muted) 55%, transparent);\r\n  text-underline-offset: 3px;\r\n  cursor: pointer;\r\n}\r\n\r\n.ob-rail__empty-link:focus-visible {\r\n  outline: 2px solid var(--mn-focus-ring, var(--mn-accent));\r\n  outline-offset: 2px;\r\n  border-radius: 2px;\r\n}\r\n\r\n/* ── Main pane ──────────────────────────────────────────────────────────── */\r\n\r\n.ob-main {\r\n  display: flex;\r\n  flex: 1;\r\n  flex-direction: column;\r\n  min-width: 0;\r\n  min-height: 0;\r\n  overflow: hidden;\r\n  background: var(--mn-bg);\r\n}\r\n\r\n.ob-pane--ask {\r\n  display: flex;\r\n  flex: 1;\r\n  flex-direction: column;\r\n  align-items: stretch;\r\n  min-height: 0;\r\n  overflow-y: auto;\r\n  overscroll-behavior: contain;\r\n  justify-content: flex-start;\r\n  padding: 32px var(--ob-gutter);\r\n  box-sizing: border-box;\r\n}\r\n\r\n.ob-ask {\r\n  width: 100%;\r\n  max-width: 640px;\r\n  margin: 0 auto;\r\n  padding: 0;\r\n  box-sizing: border-box;\r\n  min-width: 0;\r\n}\r\n\r\n/* Plan start block: flat in-pane (not the old bordered workflow card). */\r\n.ob-ask .orchestrate-hub__workflow {\r\n  width: 100%;\r\n  max-width: none;\r\n  margin: 0;\r\n  padding: 0;\r\n  border: 0;\r\n  border-radius: 0;\r\n  background: transparent;\r\n}\r\n\r\n.ob-ask .orchestrate-hub__workflow-body,\r\n.ob-ask .ob-ask__field {\r\n  width: 100%;\r\n  min-width: 0;\r\n}\r\n\r\n.ob-ask__eyebrow {\r\n  margin: 0 0 10px;\r\n  font-family: var(--font-mono);\r\n  font-size: 10px;\r\n  font-weight: 600;\r\n  letter-spacing: 0.08em;\r\n  text-transform: uppercase;\r\n  color: var(--mn-fg-muted);\r\n}\r\n\r\n.ob-ask__title,\r\n.ob-ask .orchestrate-hub__title {\r\n  margin: 0 0 10px;\r\n  color: var(--mn-fg);\r\n  font-size: 22px;\r\n  font-weight: 600;\r\n  letter-spacing: -0.02em;\r\n  line-height: 1.2;\r\n}\r\n\r\n.ob-ask__lede,\r\n.ob-ask .orchestrate-hub__lede {\r\n  margin: 0 0 22px;\r\n  max-width: 54ch;\r\n  color: var(--mn-fg-muted);\r\n  font-size: 14px;\r\n  line-height: 1.5;\r\n}\r\n\r\n.ob-ask__workspace,\r\n.ob-ask .orchestrate-hub__workspace {\r\n  margin: -12px 0 22px;\r\n  font-family: var(--font-mono);\r\n  font-size: 12px;\r\n  color: var(--mn-fg-subtle);\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n\r\n.ob-ask__workspace.hidden {\r\n  display: none;\r\n}\r\n\r\n.ob-ask__sec {\r\n  display: block;\r\n  margin: 0 0 10px;\r\n  color: var(--mn-fg-muted);\r\n  font-family: var(--font-mono);\r\n  font-size: 10px;\r\n  font-weight: 600;\r\n  letter-spacing: 0.08em;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.ob-ask__field {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 10px;\r\n  margin-bottom: 12px;\r\n}\r\n\r\n.ob-ask__field .orchestrate-hub__plan-select,\r\n.ob-ask .orchestrate-hub__plan-select {\r\n  width: 100%;\r\n  min-height: 40px;\r\n  padding: 8px 10px;\r\n  border: 1px solid var(--mn-border);\r\n  border-radius: var(--radius-sm);\r\n  background: var(--mn-bg);\r\n  color: var(--mn-fg);\r\n  font: inherit;\r\n  font-size: 14px;\r\n}\r\n\r\n.ob-ask__actions,\r\n.ob-ask .orchestrate-hub__workflow-actions {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 8px;\r\n}\r\n\r\n.ob-ask .orchestrate-hub__workflow-secondary {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 6px;\r\n}\r\n\r\n.ob-ask .orchestrate-hub__plan-refresh,\r\n.ob-ask .orchestrate-hub__make-plan-btn {\r\n  min-height: 36px;\r\n  padding: 0 12px;\r\n  border: 1px solid var(--mn-border);\r\n  border-radius: var(--radius-sm);\r\n  background: transparent;\r\n  color: var(--mn-fg-muted);\r\n  font: inherit;\r\n  font-size: 13px;\r\n  cursor: pointer;\r\n}\r\n\r\n.ob-ask .orchestrate-hub__start-btn,\r\n.ob-btn--primary {\r\n  min-height: 40px;\r\n  padding: 0 16px;\r\n  border: 1px solid var(--mn-accent);\r\n  border-radius: var(--radius-sm);\r\n  background: var(--mn-accent);\r\n  color: var(--mn-text-hover, var(--mn-bg));\r\n  font: inherit;\r\n  font-size: 13.5px;\r\n  font-weight: 600;\r\n  cursor: pointer;\r\n}\r\n\r\n.ob-ask .orchestrate-hub__start-btn:disabled {\r\n  opacity: 0.45;\r\n  cursor: not-allowed;\r\n}\r\n\r\n.ob-ask .orchestrate-hub__plan-hint {\r\n  margin: 10px 0 0;\r\n  color: var(--mn-fg-muted);\r\n  font-size: 13px;\r\n}\r\n\r\n.ob-ask .orchestrate-hub__plan-preview {\r\n  margin-top: 20px;\r\n  padding-top: 16px;\r\n  border-top: 1px solid var(--mn-border);\r\n}\r\n\r\n/* ── Board in main pane: layout only (visuals stay in orchestrate-board.css) ─ */\r\n\r\n.ob-main > .board-root {\r\n  flex: 1;\r\n  min-width: 0;\r\n  min-height: 0;\r\n  overflow: hidden;\r\n  /* Match legacy #chatArea inset (messages.css) now that the shell is edge-to-edge. */\r\n  padding: 24px 20px 12px;\r\n  box-sizing: border-box;\r\n}\r\n\r\n.ob-main > .board-root > .board-main,\r\n.ob-main > .board-root > .board-onboarding {\r\n  flex: 1;\r\n  min-height: 0;\r\n  overflow: auto;\r\n  overscroll-behavior: contain;\r\n}\r\n\r\n/* ── Rail chat level: back row, wave subgroups, chat rows ───────────────── */\r\n\r\n.ob-back {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  width: 100%;\r\n  min-height: 34px;\r\n  padding: 8px 14px;\r\n  border: 0;\r\n  border-bottom: 1px solid var(--mn-border);\r\n  background: transparent;\r\n  color: var(--mn-fg-muted);\r\n  font: inherit;\r\n  font-size: 12.5px;\r\n  text-align: left;\r\n  cursor: pointer;\r\n  transition: color var(--duration-fast, 0.12s) var(--ease-out);\r\n}\r\n\r\n.ob-back__caret {\r\n  font-size: 15px;\r\n  line-height: 1;\r\n}\r\n\r\n.ob-back:focus-visible {\r\n  outline: 2px solid var(--mn-focus-ring, var(--mn-accent));\r\n  outline-offset: -2px;\r\n}\r\n\r\n/* Wave header: quieter than a row so 6 of them do not compete with 31 chats.\r\n   Padding carries the hit area; the label stays small. */\r\n.ob-wave {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  width: 100%;\r\n  min-height: 34px;\r\n  padding: 12px 14px 7px;\r\n  border: 0;\r\n  background: transparent;\r\n  color: var(--mn-fg-muted);\r\n  font-family: var(--font-mono);\r\n  font-size: 10px;\r\n  font-weight: 600;\r\n  letter-spacing: 0.08em;\r\n  text-transform: uppercase;\r\n  text-align: left;\r\n  cursor: pointer;\r\n}\r\n\r\n.ob-wave__caret {\r\n  width: 10px;\r\n  font-size: 9px;\r\n  line-height: 1;\r\n}\r\n\r\n.ob-wave__name {\r\n  flex: 1;\r\n  min-width: 0;\r\n}\r\n\r\n.ob-wave__count {\r\n  font-size: 9.5px;\r\n  opacity: 0.75;\r\n}\r\n\r\n.ob-wave:focus-visible {\r\n  outline: 2px solid var(--mn-focus-ring, var(--mn-accent));\r\n  outline-offset: -2px;\r\n}\r\n\r\n/* Task rows sit under a wave header, so they indent to read as its children. */\r\n.ob-row--chat {\r\n  padding-left: 24px;\r\n}\r\n\r\n.ob-row--planner {\r\n  padding-left: 14px;\r\n}\r\n\r\n.ob-row--chat .ob-row__title {\r\n  -webkit-line-clamp: 1;\r\n  line-clamp: 1;\r\n  font-size: 13px;\r\n}\r\n\r\n.ob-row--planner .ob-row__title {\r\n  font-weight: 600;\r\n}\r\n\r\n.ob-row__dot {\r\n  flex: 0 0 auto;\r\n}\r\n\r\n/* ── Board chat in the main pane ─────────────────────────────────────────── */\r\n\r\n.ob-chat {\r\n  display: flex;\r\n  flex: 1;\r\n  flex-direction: column;\r\n  min-width: 0;\r\n  min-height: 0;\r\n  overflow: hidden;\r\n}\r\n\r\n/*\r\n * Header is deliberately quiet: the rail beside it is dense, and this strip\r\n * only has to say which chat you are in and how it is doing.\r\n *\r\n * Pane-edge gutters only (`--ob-gutter`), same as the transcript — tool-heavy\r\n * board chats need the full main-pane width, not a centred 790px column.\r\n */\r\n.ob-chat__head {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 14px;\r\n  flex: 0 0 auto;\r\n  padding: 12px var(--ob-gutter, 28px);\r\n  border-bottom: 1px solid var(--mn-border);\r\n}\r\n\r\n.ob-chat__back {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 4px;\r\n  flex: 0 0 auto;\r\n  min-height: 30px;\r\n  padding: 4px 10px 4px 6px;\r\n  border: 1px solid var(--mn-border);\r\n  border-radius: var(--radius-sm);\r\n  background: transparent;\r\n  color: var(--mn-fg-muted);\r\n  font: inherit;\r\n  font-size: 12.5px;\r\n  cursor: pointer;\r\n  transition:\r\n    color var(--duration-fast, 0.12s) var(--ease-out),\r\n    border-color var(--duration-fast, 0.12s) var(--ease-out);\r\n}\r\n\r\n.ob-chat__back-caret {\r\n  font-size: 15px;\r\n  line-height: 1;\r\n}\r\n\r\n.ob-chat__back:focus-visible {\r\n  outline: 2px solid var(--mn-focus-ring, var(--mn-accent));\r\n  outline-offset: 2px;\r\n}\r\n\r\n.ob-chat__titles {\r\n  flex: 1;\r\n  min-width: 0;\r\n}\r\n\r\n.ob-chat__title {\r\n  margin: 0;\r\n  color: var(--mn-fg);\r\n  font-size: 15px;\r\n  font-weight: 600;\r\n  letter-spacing: -0.01em;\r\n  line-height: 1.25;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n\r\n/* Muted, not subtle: the task id is information, and --mn-fg-subtle lands\r\n   around 3:1 against the pane background. */\r\n.ob-chat__meta {\r\n  margin: 2px 0 0;\r\n  color: var(--mn-fg-muted);\r\n  font-family: var(--font-mono);\r\n  font-size: 10.5px;\r\n  letter-spacing: 0.02em;\r\n}\r\n\r\n/* Colour never carries state alone — the chip always spells the state out. */\r\n.ob-chat__state {\r\n  flex: 0 0 auto;\r\n  padding: 3px 8px;\r\n  border: 1px solid var(--mn-border-strong);\r\n  border-radius: var(--radius-sm);\r\n  color: var(--mn-fg-muted);\r\n  font-family: var(--font-mono);\r\n  font-size: 9.5px;\r\n  font-weight: 600;\r\n  letter-spacing: 0.06em;\r\n  text-transform: uppercase;\r\n  white-space: nowrap;\r\n}\r\n\r\n/*\r\n * Semantic hues are tuned as dark-theme metric colors; at 9.5px on a light\r\n * theme they land near 4:1. Mixing toward --mn-fg pulls them darker on light\r\n * families and lighter on dark ones, which holds AA across all 16 palettes.\r\n */\r\n.ob-chat__state.is-running {\r\n  border-color: color-mix(in oklch, var(--mn-accent) 55%, transparent);\r\n  color: var(--mn-accent-ink, var(--mn-accent));\r\n}\r\n\r\n.ob-chat__state.is-complete {\r\n  border-color: color-mix(in oklch, var(--mn-success) 45%, transparent);\r\n  color: color-mix(in oklch, var(--mn-success) 62%, var(--mn-fg));\r\n}\r\n\r\n.ob-chat__state.is-failed {\r\n  border-color: color-mix(in oklch, var(--mn-danger) 45%, transparent);\r\n  color: color-mix(in oklch, var(--mn-danger) 62%, var(--mn-fg));\r\n}\r\n\r\n/*\r\n * #chatArea is overflow:hidden while Orchestrate owns the column, so the\r\n * transcript scrolls here instead (see getChatScrollRoot).\r\n */\r\n.ob-chat__scroll {\r\n  flex: 1;\r\n  min-height: 0;\r\n  overflow-y: auto;\r\n  overscroll-behavior: contain;\r\n  scroll-behavior: smooth;\r\n}\r\n\r\n/*\r\n * The transcript keeps the `.chat-area` class so message styles that key off it\r\n * still apply, which means the edge-to-edge rule at the top of this file\r\n * (`.main-column--board-view .chat-area`, 0-3-0) matches it too and would flatten\r\n * padding and the inter-message gap to 0. Hence the deliberately heavier selector.\r\n * Horizontal padding matches `.ob-chat__head` (pane gutters, not `--ob-read-col`).\r\n */\r\n.ob-chat .ob-chat__scroll .ob-chat__transcript.chat-area {\r\n  display: flex;\r\n  flex: none;\r\n  flex-direction: column;\r\n  gap: 20px;\r\n  min-height: 0;\r\n  overflow: visible;\r\n  padding: 20px var(--ob-gutter, 28px);\r\n}\r\n\r\n.ob-chat__empty {\r\n  max-width: 46ch;\r\n  padding: 28px 0;\r\n}\r\n\r\n.ob-chat__empty-title {\r\n  margin: 0 0 6px;\r\n  color: var(--mn-fg);\r\n  font-size: 14px;\r\n  font-weight: 600;\r\n}\r\n\r\n.ob-chat__empty-hint {\r\n  margin: 0;\r\n  color: var(--mn-fg-muted);\r\n  font-size: 13px;\r\n  line-height: 1.5;\r\n}\r\n\r\n/* Narrow: rail overlays like Super Plan */\r\n@container orchestrate (max-width: 659px) {\r\n  .ob-shell {\r\n    position: relative;\r\n  }\r\n\r\n  .ob-chat {\r\n    --ob-gutter: 16px;\r\n  }\r\n\r\n  .ob-rail {\r\n    position: absolute;\r\n    inset: 0 auto 0 0;\r\n    z-index: 20;\r\n    box-shadow: 4px 0 24px color-mix(in oklch, var(--mn-fg) 18%, transparent);\r\n  }\r\n\r\n  .ob-rail__collapse {\r\n    display: inline-flex;\r\n  }\r\n\r\n  .ob-page.is-rail-hidden .ob-rail {\r\n    display: none;\r\n  }\r\n}\r\n\r\n@container orchestrate (max-width: 900px) {\r\n  .ob-chat {\r\n    --ob-gutter: 20px;\r\n  }\r\n}\r\n\r\n@media (hover: hover) and (pointer: fine) {\r\n  .ob-new:hover {\r\n    background: color-mix(in oklch, var(--mn-fg) 6%, transparent);\r\n  }\r\n\r\n  .ob-rail__empty-link:hover {\r\n    text-decoration-color: var(--mn-fg);\r\n  }\r\n\r\n  .ob-row:hover {\r\n    background: var(--mn-surface-elevated, color-mix(in oklch, var(--mn-fg) 5%, transparent));\r\n  }\r\n\r\n  .ob-back:hover,\r\n  .ob-chat__back:hover {\r\n    color: var(--mn-fg);\r\n  }\r\n\r\n  .ob-chat__back:hover {\r\n    border-color: var(--mn-border-strong);\r\n  }\r\n\r\n  .ob-wave:hover {\r\n    color: var(--mn-fg);\r\n  }\r\n\r\n  .ob-ask .orchestrate-hub__plan-refresh:hover,\r\n  .ob-ask .orchestrate-hub__make-plan-btn:hover {\r\n    color: var(--mn-fg);\r\n    border-color: var(--mn-border-strong);\r\n  }\r\n}\r\n\r\n@media (prefers-reduced-motion: reduce) {\r\n  .ob-new,\r\n  .ob-row,\r\n  .ob-back,\r\n  .ob-chat__back {\r\n    transition: none;\r\n  }\r\n\r\n  .ob-chat__scroll {\r\n    scroll-behavior: auto;\r\n  }\r\n}\r\n"
