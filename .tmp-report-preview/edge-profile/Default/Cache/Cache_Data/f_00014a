 display: flex;\r\n  gap: 4px;\r\n  align-items: center;\r\n}\r\n\r\n.models-segment {\r\n  padding: 4px 10px;\r\n  font: inherit;\r\n  font-size: 11px;\r\n  color: var(--mn-fg-muted);\r\n  cursor: pointer;\r\n  background: transparent;\r\n  border: 1px solid var(--mn-border);\r\n  border-radius: var(--radius-sm);\r\n}\r\n\r\n.models-segment.is-active {\r\n  font-weight: 600;\r\n  color: var(--mn-accent-ink);\r\n  background: var(--mn-accent-soft);\r\n  border-color: var(--mn-accent-border);\r\n}\r\n\r\n/*\r\n * Segmented groups inside the toolbar. `nowrap` keeps a pair together when the\r\n * bar wraps — a \"Catalog\" on one line and \"Hugging Face\" on the next stops\r\n * reading as one control.\r\n */\r\n.models-source,\r\n.models-hub-format {\r\n  display: flex;\r\n  flex-wrap: nowrap;\r\n  gap: 4px;\r\n  align-items: center;\r\n}\r\n\r\n/* Extra breathing room so the source picker reads as its own decision, not as\r\n   the first of the filters that follow it. */\r\n.models-source {\r\n  margin-right: 4px;\r\n}\r\n\r\n/*\r\n * Refetching over results already on screen. Dimming beats swapping in\r\n * skeletons: the list keeps its height and the rows stay readable instead of\r\n * collapsing and re-expanding on every keystroke.\r\n */\r\n.models-card-list.is-stale {\r\n  opacity: 0.55;\r\n  transition: opacity 180ms var(--ease-out);\r\n}\r\n\r\n/* Announces the result count without adding a visible line above the list. */\r\n.models-hub-status {\r\n  position: absolute;\r\n  width: 1px;\r\n  height: 1px;\r\n  padding: 0;\r\n  margin: -1px;\r\n  overflow: hidden;\r\n  clip-path: inset(50%);\r\n  white-space: nowrap;\r\n}\r\n\r\n.models-card-list {\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n.models-card {\r\n  display: grid;\r\n  grid-template-columns: minmax(0, 1fr) auto;\r\n  gap: 6px 16px;\r\n  padding: 14px var(--models-gutter);\r\n  border-bottom: 1px solid var(--mn-border);\r\n}\r\n\r\n.models-card__head {\r\n  display: flex;\r\n  gap: 10px;\r\n  align-items: center;\r\n  min-width: 0;\r\n}\r\n\r\n.models-card__name-line {\r\n  display: flex;\r\n  gap: 8px;\r\n  align-items: baseline;\r\n  min-width: 0;\r\n}\r\n\r\n.models-card__name {\r\n  overflow: hidden;\r\n  font-size: 13px;\r\n  font-weight: 500;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n\r\n.models-card__owner {\r\n  flex-shrink: 0;\r\n  font-family: var(--font-mono);\r\n  font-size: 11px;\r\n  color: var(--mn-fg-muted);\r\n}\r\n\r\n.models-card__facts {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 4px;\r\n  grid-column: 1;\r\n}\r\n\r\n.models-card__actions {\r\n  display: flex;\r\n  grid-row: 1 / span 2;\r\n  grid-column: 2;\r\n  gap: 8px;\r\n  align-items: center;\r\n}\r\n\r\n.models-card__on-disk {\r\n  display: inline-flex;\r\n  gap: 5px;\r\n  align-items: center;\r\n  font-size: 11px;\r\n  font-weight: 600;\r\n  color: var(--mn-success-ink);\r\n  letter-spacing: 0.04em;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.models-card__on-disk .icon-svg {\r\n  --mn-icon-size: 12px;\r\n}\r\n\r\n/* --------------------------------------------------------- Local server */\r\n\r\n.models-status-bar {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 12px 20px;\r\n  align-items: center;\r\n  padding: 14px var(--models-gutter);\r\n  border-bottom: 1px solid var(--mn-border);\r\n}\r\n\r\n.models-status-bar__state {\r\n  display: flex;\r\n  gap: 10px;\r\n  align-items: center;\r\n}\r\n\r\n.models-status-bar__label {\r\n  display: inline-flex;\r\n  gap: 8px;\r\n  align-items: center;\r\n  font-size: 13px;\r\n  font-weight: 500;\r\n}\r\n\r\n.models-status-bar__reach {\r\n  display: flex;\r\n  flex: 1;\r\n  gap: 10px;\r\n  align-items: center;\r\n  min-width: 0;\r\n}\r\n\r\n.models-status-bar__reach .models-field-label {\r\n  margin: 0;\r\n}\r\n\r\n.models-status-bar__hint {\r\n  flex: 1;\r\n  margin: 0;\r\n  font-size: 12px;\r\n  color: var(--mn-fg-muted);\r\n}\r\n\r\n.models-switch {\r\n  position: relative;\r\n  flex-shrink: 0;\r\n  width: 34px;\r\n  height: 20px;\r\n  padding: 0;\r\n  cursor: pointer;\r\n  background: var(--mn-surface-2);\r\n  border: 1px solid var(--mn-border-strong);\r\n  border-radius: 999px;\r\n  transition: background var(--duration-fast) var(--ease-out), border-color var(--duration-fast) var(--ease-out);\r\n}\r\n\r\n.models-switch__thumb {\r\n  position: absolute;\r\n  top: 50%;\r\n  left: 3px;\r\n  width: 12px;\r\n  height: 12px;\r\n  background: var(--mn-fg-subtle);\r\n  border-radius: 50%;\r\n  transform: translateY(-50%);\r\n  transition: transform var(--duration-normal) var(--ease-out), background var(--duration-fast) var(--ease-out);\r\n}\r\n\r\n.models-switch[aria-checked='true'] {\r\n  background: var(--mn-success-soft);\r\n  border-color: var(--mn-success-border);\r\n}\r\n\r\n.models-switch[aria-checked='true'] .models-switch__thumb {\r\n  background: var(--mn-success);\r\n  transform: translate(14px, -50%);\r\n}\r\n\r\n.models-block {\r\n  padding: 18px var(--models-gutter) 22px;\r\n  border-bottom: 1px solid var(--mn-border);\r\n}\r\n\r\n.models-loaded-list {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 10px;\r\n}\r\n\r\n.models-loaded {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n  padding: 12px 14px;\r\n  background: var(--mn-surface-1);\r\n  border: 1px solid var(--mn-border);\r\n  border-radius: var(--radius-md);\r\n}\r\n\r\n.models-loaded.is-selectable {\r\n  cursor: pointer;\r\n}\r\n\r\n.models-loaded.is-selected {\r\n  background: var(--mn-accent-soft);\r\n  border-color: var(--mn-accent);\r\n}\r\n\r\n.models-loaded__head {\r\n  display: flex;\r\n  gap: 10px;\r\n  align-items: center;\r\n  min-width: 0;\r\n}\r\n\r\n.models-loaded__state {\r\n  display: inline-flex;\r\n  flex-shrink: 0;\r\n  gap: 7px;\r\n  align-items: center;\r\n  padding: 3px 9px;\r\n  font-family: var(--font-mono);\r\n  font-size: 11px;\r\n  font-variant-numeric: tabular-nums;\r\n  color: var(--mn-warning);\r\n  letter-spacing: 0.04em;\r\n  text-transform: uppercase;\r\n  background: var(--mn-warning-soft);\r\n  border-radius: var(--radius-sm);\r\n}\r\n\r\n.models-loaded__state.is-ready {\r\n  color: var(--mn-success-ink);\r\n  background: var(--mn-success-soft);\r\n}\r\n\r\n/* A slot doing prompt processing or generation. Accent, not warning — this is the\r\n   model working, which is the thing the user asked for. */\r\n.models-loaded__state.is-busy {\r\n  color: var(--mn-accent-ink);\r\n  background: var(--mn-accent-soft);\r\n}\r\n\r\n/* Waiting on a free llama.cpp slot. Warning, not accent — this is backup, not work. */\r\n.models-loaded__state.is-queued {\r\n  color: var(--mn-warning);\r\n  background: var(--mn-warning-soft);\r\n}\r\n\r\n.models-loaded__state.is-error {\r\n  color: var(--mn-danger-ink);\r\n  background: var(--mn-danger-soft);\r\n}\r\n\r\n.models-loaded__state.is-crashed {\r\n  color: var(--mn-danger-ink);\r\n  background: var(--mn-danger-soft);\r\n}\r\n\r\n.models-loaded__state.is-unhealthy {\r\n  color: var(--mn-warning);\r\n  background: var(--mn-warning-soft);\r\n}\r\n\r\n.models-loaded__name {\r\n  flex: 1;\r\n  min-width: 0;\r\n  overflow: hidden;\r\n  font-family: var(--font-mono);\r\n  font-size: 12px;\r\n  color: var(--mn-accent-ink);\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n\r\n.models-loaded__actions {\r\n  display: flex;\r\n  flex-shrink: 0;\r\n  gap: 4px;\r\n  align-items: center;\r\n}\r\n\r\n.models-loaded__meta {\r\n  margin: 0;\r\n  font-size: 12px;\r\n  color: var(--mn-fg-muted);\r\n}\r\n\r\n.models-loaded__facts {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 4px;\r\n}\r\n\r\n/* Classified llama.cpp failure — title + cause + what to do. Full border, no side stripe. */\r\n.models-serve-failure {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 6px;\r\n  padding: 10px 12px;\r\n  background: var(--mn-danger-soft);\r\n  border: 1px solid var(--mn-danger-border);\r\n  border-radius: var(--radius-md);\r\n}\r\n\r\n.models-serve-failure__title {\r\n  margin: 0;\r\n  font-size: 13px;\r\n  font-weight: 600;\r\n  color: var(--mn-danger-ink);\r\n}\r\n\r\n.models-serve-failure__detail,\r\n.models-serve-failure__fix {\r\n  margin: 0;\r\n  max-width: 75ch;\r\n  font-size: 12px;\r\n  line-height: 1.45;\r\n  color: var(--mn-fg);\r\n}\r\n\r\n.models-serve-failure__fix {\r\n  color: var(--mn-fg);\r\n}\r\n\r\n.models-spinner {\r\n  width: 9px;\r\n  height: 9px;\r\n  border: 1.5px solid currentcolor;\r\n  border-radius: 50%;\r\n  border-right-color: transparent;\r\n  animation: models-spin 0.7s linear infinite;\r\n}\r\n\r\n@keyframes models-spin {\r\n  to {\r\n    transform: rotate(360deg);\r\n  }\r\n}\r\n\r\n.models-progress {\r\n  height: 3px;\r\n  overflow: hidden;\r\n  background: var(--mn-surface-2);\r\n  border-radius: 999px;\r\n}\r\n\r\n.models-progress__fill {\r\n  width: 100%;\r\n  height: 100%;\r\n  background: var(--mn-accent);\r\n  border-radius: 999px;\r\n  transform: scaleX(var(--progress, 0));\r\n  transform-origin: left center;\r\n  transition: transform var(--duration-normal) var(--ease-out);\r\n}\r\n\r\n.models-progress__fill.is-indeterminate {\r\n  width: 34%;\r\n  animation: models-indeterminate 1.5s var(--ease-out) infinite alternate;\r\n}\r\n\r\n@keyframes models-indeterminate {\r\n  from {\r\n    margin-left: 0;\r\n  }\r\n\r\n  to {\r\n    margin-left: 66%;\r\n  }\r\n}\r\n\r\n.models-endpoints__summary {\r\n  display: flex;\r\n  gap: 10px;\r\n  align-items: center;\r\n  cursor: pointer;\r\n  list-style: none;\r\n}\r\n\r\n.models-endpoints__summary::-webkit-details-marker {\r\n  display: none;\r\n}\r\n\r\n.models-endpoints__summary .models-block__label {\r\n  margin: 0;\r\n}\r\n\r\n.models-endpoints__count {\r\n  font-family: var(--font-mono);\r\n  font-size: 11px;\r\n  color: var(--mn-fg-muted);\r\n}\r\n\r\n.models-endpoints__list {\r\n  margin-top: 10px;\r\n}\r\n\r\n.models-endpoint {\r\n  display: grid;\r\n  grid-template-columns: 3rem minmax(0, 14rem) minmax(0, 1fr) auto;\r\n  gap: 12px;\r\n  align-items: center;\r\n  min-height: 32px;\r\n  border-bottom: 1px solid var(--mn-border);\r\n}\r\n\r\n.models-endpoint:last-child {\r\n  border-bottom: none;\r\n}\r\n\r\n.models-endpoint__method {\r\n  font-family: var(--font-mono);\r\n  font-size: 10px;\r\n  font-weight: 600;\r\n  color: var(--mn-fg-muted);\r\n  letter-spacing: 0.06em;\r\n}\r\n\r\n.models-endpoint__method--post {\r\n  color: var(--mn-accent-ink);\r\n}\r\n\r\n.models-endpoint__path {\r\n  overflow: hidden;\r\n  font-family: var(--font-mono);\r\n  font-size: 12px;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n\r\n.models-endpoint__note {\r\n  overflow: hidden;\r\n  font-size: 12px;\r\n  color: var(--mn-fg-muted);\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n\r\n/* -------------------------------------------------------------- log pane */\r\n\r\n.models-logs {\r\n  display: flex;\r\n  /* Grow to fill leftover stage height; 14rem basis keeps a usable empty pane.\r\n     min-height: 0 lets the pane shrink below log content so lines scroll\r\n     inside the body instead of painting past the window (MIN-606). */\r\n  flex: 1 1 14rem;\r\n  min-height: 0;\r\n  flex-direction: column;\r\n  overflow: hidden;\r\n}\r\n\r\n.models-logs__head {\r\n  display: flex;\r\n  gap: 10px;\r\n  align-items: center;\r\n  padding: 10px var(--models-gutter);\r\n}\r\n\r\n.models-logs__head .models-block__label {\r\n  margin: 0;\r\n}\r\n\r\n.models-logs__controls {\r\n  display: flex;\r\n  gap: 2px;\r\n  align-items: center;\r\n  margin-left: auto;\r\n}\r\n\r\n.models-logs__body {\r\n  flex: 1 1 auto;\r\n  min-height: 0;\r\n  padding: 10px var(--models-gutter) 16px;\r\n  margin: 0;\r\n  overflow: auto;\r\n  overscroll-behavior: contain;\r\n  font-family: var(--font-mono);\r\n  font-size: 11.5px;\r\n  line-height: 1.65;\r\n  background: var(--mn-surface-0);\r\n  border-top: 1px solid var(--mn-border);\r\n}\r\n\r\n.models-log-line {\r\n  color: var(--mn-fg-muted);\r\n  white-space: pre-wrap;\r\n  word-break: break-word;\r\n}\r\n\r\n.models-log-line--error {\r\n  color: var(--mn-danger);\r\n}\r\n\r\n.models-log-line--warn {\r\n  color: var(--mn-warning);\r\n}\r\n\r\n.models-log-line--info {\r\n  color: var(--mn-fg);\r\n}\r\n\r\n/* One readable step below plain output, still above the AA floor. */\r\n.models-log-line--debug {\r\n  color: color-mix(in srgb, var(--mn-fg-muted) 86%, var(--mn-bg));\r\n}\r\n\r\n/* ---------------------------------------------------------------- fields */\r\n\r\n.models-field,\r\n.models-field-block {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 5px;\r\n  margin-bottom: 12px;\r\n}\r\n\r\n.models-field--check {\r\n  flex-direction: row;\r\n  gap: 8px;\r\n  align-items: center;\r\n  font-size: 13px;\r\n}\r\n\r\n.models-field--check input {\r\n  margin: 0;\r\n  accent-color: var(--mn-accent);\r\n}\r\n\r\n.models-field__label {\r\n  font-size: 11px;\r\n  font-weight: 600;\r\n  color: var(--mn-fg-muted);\r\n  letter-spacing: 0.06em;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.models-field__input {\r\n  width: 100%;\r\n  height: 32px;\r\n  padding: 0 10px;\r\n  font: inherit;\r\n  font-size: 13px;\r\n  color: var(--mn-fg);\r\n  background: var(--mn-bg);\r\n  border: 1px solid var(--mn-border-strong);\r\n  border-radius: var(--radius-sm);\r\n  box-sizing: border-box;\r\n}\r\n\r\n.models-field__input:focus {\r\n  border-color: var(--mn-accent);\r\n  outline: none;\r\n}\r\n\r\n.models-field__range-head {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 8px;\r\n  min-width: 0;\r\n}\r\n\r\n.models-field__range-meta {\r\n  display: flex;\r\n  align-items: baseline;\r\n  gap: 8px;\r\n  flex-shrink: 1;\r\n  min-width: 0;\r\n}\r\n\r\n.models-field__range-value {\r\n  font-family: var(--font-mono);\r\n  font-size: 12px;\r\n  font-variant-numeric: tabular-nums;\r\n  color: var(--mn-fg-muted);\r\n  white-space: nowrap;\r\n}\r\n\r\n/* Quiet restore next to a custom GPU-layer count. Not a chip: Auto is a mode, not a preset. */\r\n.models-field__auto {\r\n  margin: 0;\r\n  padding: 2px 0;\r\n  border: 0;\r\n  background: transparent;\r\n  font-family: var(--font-mono);\r\n  font-size: 11px;\r\n  font-weight: 600;\r\n  letter-spacing: 0.06em;\r\n  text-transform: uppercase;\r\n  color: var(--mn-fg-muted);\r\n  cursor: pointer;\r\n}\r\n\r\n@media (hover: hover) and (pointer: fine) {\r\n  .models-field__auto:hover {\r\n    color: var(--mn-fg);\r\n  }\r\n}\r\n\r\n.models-field__auto:focus-visible {\r\n  outline: 2px solid var(--mn-accent);\r\n  outline-offset: 2px;\r\n}\r\n\r\n/* Compact token count next to the context slider — same type as the read-only value. */\r\n.models-field__range-value-input {\r\n  width: 10ch;\r\n  margin: 0;\r\n  padding: 0 2px;\r\n  border: 1px solid transparent;\r\n  border-radius: var(--radius-sm);\r\n  background: transparent;\r\n  font-family: var(--font-mono);\r\n  font-size: 12px;\r\n  font-variant-numeric: tabular-nums;\r\n  color: var(--mn-fg-muted);\r\n  text-align: right;\r\n  appearance: textfield;\r\n  -moz-appearance: textfield;\r\n}\r\n\r\n.models-field__range-value-input::-webkit-outer-spin-button,\r\n.models-field__range-value-input::-webkit-inner-spin-button {\r\n  -webkit-appearance: none;\r\n  appearance: none;\r\n  margin: 0;\r\n}\r\n\r\n.models-field__range-value-input:hover,\r\n.models-field__range-value-input:focus {\r\n  border-color: var(--mn-border);\r\n  color: var(--mn-fg);\r\n  outline: none;\r\n}\r\n\r\n.models-field__range-value-input:focus {\r\n  border-color: var(--mn-accent);\r\n}\r\n\r\n.models-field__range {\r\n  width: 100%;\r\n  margin: 0;\r\n  cursor: pointer;\r\n  accent-color: var(--mn-accent);\r\n}\r\n\r\n.models-inline-form {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 8px;\r\n  align-items: center;\r\n  margin-top: 10px;\r\n}\r\n\r\n.models-inline-form + .models-btn {\r\n  margin-top: 10px;\r\n}\r\n\r\n.models-inline-form .models-field__input {\r\n  flex: 1 1 16rem;\r\n  min-width: 10rem;\r\n}\r\n\r\n.models-preset-row {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 6px;\r\n}\r\n\r\n.models-preset {\r\n  padding: 5px 11px;\r\n  font: inherit;\r\n  font-size: 12px;\r\n  color: var(--mn-fg-muted);\r\n  cursor: pointer;\r\n  background: transparent;\r\n  border: 1px solid var(--mn-border);\r\n  border-radius: var(--radius-sm);\r\n}\r\n\r\n.models-preset.is-active {\r\n  font-weight: 600;\r\n  color: var(--mn-accent-ink);\r\n  background: var(--mn-accent-soft);\r\n  border-color: var(--mn-accent-border);\r\n}\r\n\r\n.models-preset.is-tight {\r\n  color: var(--mn-fg-muted);\r\n  border-style: dashed;\r\n}\r\n\r\n/* Stacked collapsible groups in the Load tab — LM Studio-style accordions. */\r\n.models-advanced-stack {\r\n  margin-top: 4px;\r\n  border-top: 1px solid var(--mn-border);\r\n}\r\n\r\n.models-advanced {\r\n  border-top: 1px solid var(--mn-border);\r\n}\r\n\r\n.models-advanced-stack > .models-advanced:first-child {\r\n  border-top: none;\r\n}\r\n\r\n.models-advanced__summary {\r\n  display: flex;\r\n  gap: 8px;\r\n  align-items: center;\r\n  padding: 11px 0;\r\n  font-size: 13px;\r\n  font-weight: 600;\r\n  color: var(--mn-fg);\r\n  letter-spacing: -0.01em;\r\n  text-transform: none;\r\n  cursor: pointer;\r\n  list-style: none;\r\n  user-select: none;\r\n}\r\n\r\n.models-advanced__summary::-webkit-details-marker {\r\n  display: none;\r\n}\r\n\r\n.models-advanced__summary::before {\r\n  flex-shrink: 0;\r\n  width: 0;\r\n  height: 0;\r\n  content: '';\r\n  border-top: 4px solid transparent;\r\n  border-bottom: 4px solid transparent;\r\n  border-left: 5px solid var(--mn-fg-muted);\r\n  transition: transform var(--duration-fast) var(--ease-out);\r\n}\r\n\r\n.models-advanced[open] > .models-advanced__summary::before {\r\n  transform: rotate(90deg);\r\n}\r\n\r\n@media (hover: hover) and (pointer: fine) {\r\n  .models-advanced__summary:hover {\r\n    color: var(--mn-fg);\r\n  }\r\n\r\n  .models-advanced__summary:hover::before {\r\n    border-left-color: var(--mn-fg);\r\n  }\r\n}\r\n\r\n.models-advanced__summary:focus-visible {\r\n  outline: 2px solid var(--mn-accent);\r\n  outline-offset: 2px;\r\n  border-radius: var(--radius-sm);\r\n}\r\n\r\n.models-advanced[open] {\r\n  padding-bottom: 4px;\r\n}\r\n\r\n.models-advanced__body {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 14px;\r\n  padding: 0 0 14px 13px;\r\n}\r\n\r\n.models-advanced__body .models-field,\r\n.models-advanced__body .models-field-block {\r\n  gap: 6px;\r\n  margin-bottom: 0;\r\n}\r\n\r\n.models-advanced__body .models-field__label {\r\n  line-height: 1.35;\r\n  white-space: normal;\r\n}\r\n\r\n.models-advanced__body .models-field__input {\r\n  height: 34px;\r\n}\r\n\r\n.models-advanced__body .models-field--check {\r\n  gap: 10px;\r\n  align-items: flex-start;\r\n  min-height: 34px;\r\n  padding: 2px 0;\r\n  font-size: 13px;\r\n  line-height: 1.4;\r\n  color: var(--mn-fg);\r\n}\r\n\r\n.models-advanced__body .models-field--check input {\r\n  flex-shrink: 0;\r\n  margin-top: 2px;\r\n}\r\n\r\n/* Per-GPU tensor-split: range plus a compact weight field. */\r\n.models-field--gpu-ratio {\r\n  display: grid;\r\n  grid-template-columns: minmax(0, 1fr) 7ch;\r\n  gap: 8px;\r\n  align-items: center;\r\n}\r\n\r\n.models-field--gpu-ratio .models-field__range-head {\r\n  grid-column: 1 / -1;\r\n}\r\n\r\n.models-field--gpu-ratio .models-field__range {\r\n  width: 100%;\r\n  min-width: 0;\r\n}\r\n\r\n.models-field--gpu-ratio .models-field__input {\r\n  width: 7ch;\r\n  height: 32px;\r\n  padding: 0 6px;\r\n  font-family: var(--font-mono);\r\n  font-variant-numeric: tabular-nums;\r\n}\r\n\r\n.models-advanced__body .models-hint {\r\n  margin: -4px 0 0;\r\n}\r\n\r\n.models-copy-field {\r\n  display: flex;\r\n  gap: 4px;\r\n  align-items: center;\r\n  min-width: 0;\r\n  padding: 0 4px 0 10px;\r\n  background: var(--mn-bg);\r\n  border: 1px solid var(--mn-border);\r\n  border-radius: var(--radius-sm);\r\n}\r\n\r\n.models-copy-field__value {\r\n  flex: 1;\r\n  min-width: 0;\r\n  padding: 6px 0;\r\n  overflow: hidden;\r\n  font-family: var(--font-mono);\r\n  font-size: 11.5px;\r\n  color: var(--mn-fg);\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n\r\n.models-path-list {\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n.models-path-row {\r\n  display: flex;\r\n  gap: 10px;\r\n  align-items: center;\r\n  min-height: 36px;\r\n  border-bottom: 1px solid var(--mn-border);\r\n}\r\n\r\n.models-path-row:last-child {\r\n  border-bottom: none;\r\n}\r\n\r\n.models-path-row .icon-svg {\r\n  --mn-icon-size: 14px;\r\n  color: var(--mn-fg-subtle);\r\n}\r\n\r\n.models-path-row__path {\r\n  flex: 1;\r\n  min-width: 0;\r\n  overflow: hidden;\r\n  font-family: var(--font-mono);\r\n  font-size: 12px;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n\r\n.models-path-row.is-builtin .models-path-row__path {\r\n  color: var(--mn-fg-muted);\r\n}\r\n\r\n.models-path-row__note {\r\n  flex-shrink: 0;\r\n  font-size: 11px;\r\n  color: var(--mn-fg-muted);\r\n}\r\n\r\n/* ------------------------------------------------------ empty + loading */\r\n\r\n.models-empty {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 6px;\r\n  align-items: center;\r\n  padding: 48px 24px;\r\n  text-align: center;\r\n}\r\n\r\n.models-empty__glyph {\r\n  --mn-icon-size: 26px;\r\n  margin-bottom: 6px;\r\n  color: var(--mn-fg-subtle);\r\n}\r\n\r\n.models-empty__title {\r\n  margin: 0;\r\n  font-size: 14px;\r\n  font-weight: 600;\r\n}\r\n\r\n.models-empty__body {\r\n  max-width: 40ch;\r\n  margin: 0 0 8px;\r\n  font-size: 13px;\r\n  color: var(--mn-fg-muted);\r\n}\r\n\r\n.models-inspector .models-empty {\r\n  padding: 24px 20px;\r\n}\r\n\r\n.models-skeleton {\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n.models-skeleton__row {\r\n  height: 52px;\r\n  border-bottom: 1px solid var(--mn-border);\r\n  background: linear-gradient(\r\n    90deg,\r\n    transparent 0%,\r\n    color-mix(in srgb, var(--mn-fg) 5%, transparent) 50%,\r\n    transparent 100%\r\n  );\r\n  background-size: 200% 100%;\r\n  animation: models-shimmer 1.4s linear infinite;\r\n}\r\n\r\n@keyframes models-shimmer {\r\n  from {\r\n    background-position: 200% 0;\r\n  }\r\n\r\n  to {\r\n    background-position: -200% 0;\r\n  }\r\n}\r\n\r\n/* ---------------------------------------------------------------- dialog */\r\n\r\n.models-dialog__backdrop {\r\n  position: fixed;\r\n  inset: 0;\r\n  z-index: 1000;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  background: oklch(0% 0 0 / 0.45);\r\n}\r\n\r\n.models-dialog {\r\n  width: min(26rem, calc(100vw - 2rem));\r\n  max-height: calc(100vh - 2rem);\r\n  padding: 20px;\r\n  overflow-y: auto;\r\n  background: var(--mn-surface-1);\r\n  border: 1px solid var(--mn-border-strong);\r\n  border-radius: var(--radius-md);\r\n}\r\n\r\n.models-dialog__title {\r\n  margin: 0 0 10px;\r\n  font-size: 15px;\r\n  font-weight: 600;\r\n  letter-spacing: -0.01em;\r\n}\r\n\r\n.models-dialog__body {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n  font-size: 13px;\r\n}\r\n\r\n.models-dialog__progress {\r\n  margin-top: 14px;\r\n}\r\n\r\n.models-dialog__progress.hidden {\r\n  display: none;\r\n}\r\n\r\n.models-dialog__progress-label {\r\n  margin: 8px 0 0;\r\n  font-size: 12px;\r\n  color: var(--mn-fg-muted);\r\n}\r\n\r\n.models-dialog__actions {\r\n  display: flex;\r\n  gap: 8px;\r\n  justify-content: flex-end;\r\n  margin-top: 18px;\r\n}\r\n\r\n/* ------------------------------------------------------------ responsive */\r\n\r\n/* Drop quant and context before the name and maker start truncating. */\r\n@container models (max-width: 1180px) {\r\n  .models-table__head,\r\n  .models-row {\r\n    grid-template-columns: minmax(0, 2.2fr) minmax(0, 1fr) 4.5rem 5.5rem minmax(8rem, auto);\r\n  }\r\n\r\n  .models-row__cell--quant,\r\n  .models-row__cell--context {\r\n    display: none;\r\n  }\r\n}\r\n\r\n/* Too narrow for three columns: the inspector slides over the surface. */\r\n@container models (max-width: 1040px) {\r\n  .models-page-body {\r\n    --models-rail-w: 176px;\r\n    --models-gutter: 16px;\r\n  }\r\n\r\n  .models-inspector {\r\n    position: absolute;\r\n    inset: 0 0 0 auto;\r\n    z-index: 5;\r\n    width: min(var(--models-inspector-w), 90%);\r\n    min-width: min(var(--models-inspector-w), 90%);\r\n    max-width: min(var(--models-inspector-w), 90%);\r\n    box-shadow: -6px 0 24px var(--mn-shadow);\r\n  }\r\n}\r\n\r\n@container models (max-width: 780px) {\r\n  .models-page-body {\r\n    --models-gutter: 14px;\r\n\r\n    flex-direction: column;\r\n  }\r\n\r\n  .models-nav {\r\n    flex: 0 0 auto;\r\n    flex-direction: row;\r\n    gap: 12px;\r\n    overflow-x: auto;\r\n    border-right: none;\r\n    border-bottom: 1px solid var(--mn-border);\r\n  }\r\n\r\n  .models-nav__group {\r\n    flex-direction: row;\r\n    align-items: center;\r\n  }\r\n\r\n  .models-nav__group-label {\r\n    display: none;\r\n  }\r\n\r\n  .models-nav button {\r\n    white-space: nowrap;\r\n  }\r\n\r\n  .models-table__head {\r\n    display: none;\r\n  }\r\n\r\n  .models-row {\r\n    grid-template-columns: minmax(0, 1fr) auto;\r\n    min-height: 48px;\r\n    padding: 10px var(--models-gutter);\r\n  }\r\n\r\n  .models-row__cell {\r\n    display: none;\r\n  }\r\n\r\n  .models-card {\r\n    grid-template-columns: minmax(0, 1fr);\r\n  }\r\n\r\n  .models-card__actions {\r\n    grid-row: auto;\r\n    grid-column: 1;\r\n    margin-top: 4px;\r\n  }\r\n\r\n  .models-endpoint {\r\n    grid-template-columns: 3rem minmax(0, 1fr) auto;\r\n  }\r\n\r\n  .models-endpoint__note {\r\n    display: none;\r\n  }\r\n\r\n  .models-header-status {\r\n    display: none;\r\n  }\r\n}\r\n\r\n/* Phone: the container query above already stacks the layout; this sizes the\r\n   controls for thumbs and lets the inspector own the full sheet. */\r\n@container models (max-width: 560px) {\r\n  .models-page-body {\r\n    --models-inspector-w: 100%;\r\n  }\r\n\r\n  .models-inspector {\r\n    width: 100%;\r\n    min-width: 100%;\r\n    max-width: 100%;\r\n  }\r\n\r\n  .models-toolbar {\r\n    gap: 8px;\r\n  }\r\n\r\n  .models-search {\r\n    flex: 1 1 100%;\r\n    min-width: 0;\r\n  }\r\n\r\n  .models-search__input,\r\n  .models-select,\r\n  .models-range {\r\n    height: 40px;\r\n  }\r\n\r\n  .models-select {\r\n    max-width: none;\r\n    flex: 1 1 8rem;\r\n  }\r\n\r\n  .models-toolbar__count {\r\n    margin-left: 0;\r\n  }\r\n\r\n  .models-btn,\r\n  .models-icon-btn,\r\n  .models-inspector-toggle {\r\n    min-height: 40px;\r\n    min-width: 40px;\r\n  }\r\n\r\n  .models-segment {\r\n    min-height: 40px;\r\n    padding: 4px 12px;\r\n  }\r\n\r\n  /* The source pair leads its own line once the search field takes the full\r\n     width, so it needs the toolbar gap rather than its own nudge. */\r\n  .models-source {\r\n    margin-right: 0;\r\n  }\r\n\r\n  /* Download counts are the first fact worth losing when the row runs out of\r\n     width — params, quant, and size all bear on whether the model will run. */\r\n  .models-chip--optional {\r\n    display: none;\r\n  }\r\n\r\n  .models-card__actions {\r\n    flex-wrap: wrap;\r\n  }\r\n}\r\n\r\n@media (prefers-reduced-motion: reduce) {\r\n  .models-dot--starting,\r\n  .models-dot--unhealthy,\r\n  .models-spinner,\r\n  .models-progress__fill.is-indeterminate,\r\n  .models-skeleton__row {\r\n    animation: none;\r\n  }\r\n\r\n  .models-progress__fill.is-indeterminate {\r\n    width: 100%;\r\n    opacity: 0.4;\r\n    transform: none;\r\n  }\r\n\r\n  .models-progress__fill {\r\n    transition: none;\r\n  }\r\n\r\n  /* The dim still conveys \"refetching\" — only the fade to it is dropped. */\r\n  .models-card-list.is-stale {\r\n    transition: none;\r\n  }\r\n}\r\n\r\n/* Reparented settings sections keep their own styling.\r\n   Models panels already own the centered column — do not double-constrain. */\r\n.models-section .settings-sec