const __vite__css = "/**\r\n * Models workbench — rail, surface, and inspector.\r\n *\r\n * Three columns: sections on the left, the working surface in the middle, the\r\n * selected model's detail on the right. Separation is borders and surface\r\n * level, never floating cards.\r\n */\r\n\r\n.models-page {\r\n  display: none;\r\n  flex-direction: column;\r\n  /* Fill the OS app layer (stage below menubar), not the full viewport.\r\n     100vh here clips the Local Server runtime log under the stage (MIN-606). */\r\n  height: 100%;\r\n  min-height: 0;\r\n  overflow: hidden;\r\n  background: var(--mn-bg);\r\n  color: var(--mn-fg);\r\n  font-family: var(--font-ui);\r\n  font-size: 14px;\r\n  line-height: 1.5;\r\n\r\n  /* Width rules use @container so they track the app surface, not the viewport. */\r\n  container: models / inline-size;\r\n}\r\n\r\n.models-page.is-open {\r\n  display: flex;\r\n}\r\n\r\n/* Legacy full-page takeover when the OS shell is off (browser-only). */\r\nhtml:not(.minnow-os-enabled) .models-page.is-open {\r\n  height: 100vh;\r\n}\r\n\r\n/* ---------------------------------------------------------------- header */\r\n\r\n.models-page-header {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n  min-height: var(--topbar-h);\r\n  padding: 0 12px 0 16px;\r\n  border-bottom: 1px solid var(--mn-border);\r\n}\r\n\r\n.models-page-header__title {\r\n  margin: 0;\r\n  font-size: 15px;\r\n  font-weight: 600;\r\n  letter-spacing: -0.02em;\r\n}\r\n\r\n.models-header-status {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  min-width: 0;\r\n  margin-left: auto;\r\n  padding: 4px 10px;\r\n  border: 1px solid var(--mn-border);\r\n  border-radius: 999px;\r\n}\r\n\r\n.models-header-status__label {\r\n  overflow: hidden;\r\n  font-family: var(--font-mono);\r\n  font-size: 11px;\r\n  color: var(--mn-fg-muted);\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n\r\n/* Compact header control — global .icon-btn is 40px; this sits beside status text. */\r\n.models-inspector-toggle {\r\n  flex-shrink: 0;\r\n  width: 28px;\r\n  height: 28px;\r\n  padding: 0;\r\n}\r\n\r\n.models-inspector-toggle .icon-svg {\r\n  --mn-icon-size: 15px;\r\n}\r\n\r\n/* ------------------------------------------------------------------ body */\r\n\r\n/* Sizing lives here, not on .models-page: an @container rule only matches\r\n   descendants of its container, never the container element itself. */\r\n.models-page-body {\r\n  --models-rail-w: 212px;\r\n  --models-inspector-w: 360px;\r\n  --models-gutter: 20px;\r\n\r\n  position: relative;\r\n  display: flex;\r\n  flex: 1;\r\n  min-height: 0;\r\n}\r\n\r\n.models-nav {\r\n  display: flex;\r\n  flex: 0 0 var(--models-rail-w);\r\n  flex-direction: column;\r\n  gap: 20px;\r\n  padding: 16px 10px;\r\n  overflow-y: auto;\r\n  background: var(--mn-surface-1);\r\n  border-right: 1px solid var(--mn-border);\r\n}\r\n\r\n.models-nav__group {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 2px;\r\n}\r\n\r\n.models-nav__group-label {\r\n  padding: 0 10px 6px;\r\n  font-size: 11px;\r\n  font-weight: 600;\r\n  color: var(--mn-fg-muted);\r\n  letter-spacing: 0.08em;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.models-nav button {\r\n  display: flex;\r\n  gap: 10px;\r\n  align-items: center;\r\n  padding: 7px 10px;\r\n  font: inherit;\r\n  font-size: 13px;\r\n  color: var(--mn-fg-muted);\r\n  text-align: left;\r\n  cursor: pointer;\r\n  background: transparent;\r\n  border: none;\r\n  border-radius: var(--radius-sm);\r\n  transition: background var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out);\r\n}\r\n\r\n.models-nav button .icon-svg {\r\n  --mn-icon-size: 15px;\r\n  color: var(--mn-fg-subtle);\r\n}\r\n\r\n.models-nav button[aria-current='page'] {\r\n  font-weight: 600;\r\n  color: var(--mn-fg);\r\n  background: var(--mn-accent-soft);\r\n}\r\n\r\n.models-nav button[aria-current='page'] .icon-svg {\r\n  color: var(--mn-accent);\r\n}\r\n\r\n.models-content {\r\n  display: flex;\r\n  flex: 1;\r\n  min-width: 0;\r\n  min-height: 0;\r\n  flex-direction: column;\r\n  /* Workbench tables scroll inside .models-surface; settings-style sections scroll here. */\r\n  overflow: hidden;\r\n}\r\n\r\n.models-content:has(.models-section.is-active:not(.models-section--flush)) {\r\n  overflow-y: auto;\r\n}\r\n\r\n.models-section {\r\n  display: none;\r\n  box-sizing: border-box;\r\n  width: 100%;\r\n  padding: 24px var(--models-gutter);\r\n}\r\n\r\n.models-section.is-active {\r\n  display: block;\r\n}\r\n\r\n/* Settings-style sections: centered column (matches Brain → Settings). */\r\n.models-section.models-section--centered {\r\n  width: 100%;\r\n  max-width: 52rem;\r\n  margin-inline: auto;\r\n}\r\n\r\n.models-section.models-section--centered.models-section--settings-wide {\r\n  max-width: min(72rem, 100%);\r\n}\r\n\r\n.models-section.models-section--centered > h2,\r\n.models-section.models-section--centered > .models-lead {\r\n  max-width: none;\r\n}\r\n\r\n.models-section.models-section--centered .settings-section-body {\r\n  width: 100%;\r\n  min-width: 0;\r\n  align-items: center;\r\n}\r\n\r\n.models-section.models-section--centered .settings-general.settings-general--wide {\r\n  width: 100%;\r\n  max-width: 100%;\r\n}\r\n\r\n/* Keep section titles readable without capping the scroll column width. */\r\n.models-section:not(.models-section--flush) > h2,\r\n.models-section:not(.models-section--flush) > .models-lead {\r\n  max-width: 56rem;\r\n}\r\n\r\n/* Workbench sections own their whole column and scroll internally. */\r\n.models-section--flush {\r\n  max-width: none;\r\n  padding: 0;\r\n  overflow: hidden;\r\n}\r\n\r\n.models-section--flush.is-active {\r\n  display: flex;\r\n  flex: 1;\r\n  min-height: 0;\r\n  flex-direction: column;\r\n}\r\n\r\n.models-surface {\r\n  display: flex;\r\n  flex: 1;\r\n  min-height: 0;\r\n  flex-direction: column;\r\n  overflow-y: auto;\r\n}\r\n\r\n.models-section h2 {\r\n  margin: 0 0 6px;\r\n  font-size: 19px;\r\n  font-weight: 600;\r\n  letter-spacing: -0.02em;\r\n}\r\n\r\n.models-lead {\r\n  max-width: 62ch;\r\n  margin: 0 0 24px;\r\n  color: var(--mn-fg-muted);\r\n}\r\n\r\n.models-muted {\r\n  color: var(--mn-fg-muted);\r\n}\r\n\r\n.models-error {\r\n  color: var(--mn-danger);\r\n}\r\n\r\n.models-hint {\r\n  margin: 6px 0 0;\r\n  font-size: 12px;\r\n  color: var(--mn-fg-muted);\r\n}\r\n\r\n.models-hint--warn {\r\n  color: var(--mn-danger);\r\n}\r\n\r\n/* Planner miss / trainCtx notes — warning tone, not the danger used for tight VRAM. */\r\n.models-hint--warning {\r\n  color: var(--mn-warning);\r\n}\r\n\r\n/*\r\n * Launch memory occupancy — bench gauges above the context / GPU-layer sliders.\r\n * Not a card: same surface as the inspector, hairline tracks, mono values.\r\n */\r\n.models-launch-memory {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 10px;\r\n  margin: 0 0 14px;\r\n}\r\n\r\n.models-launch-memory__row {\r\n  display: grid;\r\n  grid-template-columns: auto 1fr;\r\n  column-gap: 10px;\r\n  row-gap: 4px;\r\n  align-items: baseline;\r\n}\r\n\r\n.models-launch-memory__kind {\r\n  font-size: 11px;\r\n  font-weight: 600;\r\n  letter-spacing: 0.06em;\r\n  color: var(--mn-fg-muted);\r\n}\r\n\r\n.models-launch-memory__value {\r\n  justify-self: end;\r\n  font-family: var(--font-mono);\r\n  font-size: 12px;\r\n  font-variant-numeric: tabular-nums;\r\n  color: var(--mn-fg);\r\n  white-space: nowrap;\r\n}\r\n\r\n.models-launch-memory__row[data-tone='warn'] .models-launch-memory__value {\r\n  color: var(--mn-warning);\r\n}\r\n\r\n.models-launch-memory__row[data-tone='tight'] .models-launch-memory__value,\r\n.models-launch-memory__row[data-tone='over'] .models-launch-memory__value {\r\n  color: var(--mn-danger);\r\n}\r\n\r\n.models-launch-memory__track {\r\n  grid-column: 1 / -1;\r\n  height: 6px;\r\n  overflow: hidden;\r\n  background: var(--mn-border-strong);\r\n  border-radius: 3px;\r\n}\r\n\r\n.models-launch-memory__fill {\r\n  width: 100%;\r\n  height: 100%;\r\n  border-radius: inherit;\r\n  background: color-mix(in oklch, var(--mn-fg) 48%, transparent);\r\n  /* Instant: this node is replaced on each slider tick; the range stays put. */\r\n  transform: scaleX(var(--fill, 0));\r\n  transform-origin: left center;\r\n}\r\n\r\n.models-launch-memory__row[data-tone='warn'] .models-launch-memory__fill {\r\n  background: var(--mn-warning);\r\n}\r\n\r\n.models-launch-memory__row[data-tone='tight'] .models-launch-memory__fill,\r\n.models-launch-memory__row[data-tone='over'] .models-launch-memory__fill {\r\n  background: var(--mn-danger);\r\n}\r\n\r\n.models-launch-memory__note,\r\n.models-launch-memory__caption {\r\n  margin: 0;\r\n  font-size: 12px;\r\n  color: var(--mn-fg-muted);\r\n}\r\n\r\n.models-launch-memory__caption--warn {\r\n  color: var(--mn-danger);\r\n}\r\n\r\n/* ------------------------------------------------------------- inspector */\r\n\r\n.models-inspector {\r\n  display: flex;\r\n  flex: 0 0 var(--models-inspector-w);\r\n  flex-direction: column;\r\n  align-self: stretch;\r\n  width: var(--models-inspector-w);\r\n  min-width: var(--models-inspector-w);\r\n  max-width: var(--models-inspector-w);\r\n  min-height: 0;\r\n  overflow: hidden;\r\n  background: var(--mn-surface-1);\r\n  border-left: 1px solid var(--mn-border);\r\n}\r\n\r\n.models-page.is-inspector-hidden .models-inspector,\r\n.models-page:not(.is-workbench) .models-inspector {\r\n  display: none;\r\n}\r\n\r\n.models-inspector.is-empty {\r\n  align-items: center;\r\n  justify-content: center;\r\n}\r\n\r\n.models-inspector__head {\r\n  display: flex;\r\n  gap: 10px;\r\n  align-items: center;\r\n  padding: 14px 16px;\r\n  border-bottom: 1px solid var(--mn-border);\r\n}\r\n\r\n.models-inspector__glyph {\r\n  --mn-icon-size: 16px;\r\n  color: var(--mn-accent);\r\n}\r\n\r\n.models-inspector__title {\r\n  flex: 1;\r\n  min-width: 0;\r\n  margin: 0;\r\n  overflow: hidden;\r\n  font-size: 14px;\r\n  font-weight: 600;\r\n  letter-spacing: -0.01em;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n\r\n.models-inspector__tabs {\r\n  display: flex;\r\n  gap: 2px;\r\n  padding: 8px 12px;\r\n  border-bottom: 1px solid var(--mn-border);\r\n}\r\n\r\n.models-tab {\r\n  display: flex;\r\n  flex: 1;\r\n  gap: 6px;\r\n  align-items: center;\r\n  justify-content: center;\r\n  padding: 6px 8px;\r\n  font: inherit;\r\n  font-size: 12px;\r\n  color: var(--mn-fg-muted);\r\n  cursor: pointer;\r\n  background: transparent;\r\n  border: none;\r\n  border-radius: var(--radius-sm);\r\n  transition: background var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out);\r\n}\r\n\r\n.models-tab .icon-svg {\r\n  --mn-icon-size: 13px;\r\n}\r\n\r\n.models-tab[aria-selected='true'] {\r\n  font-weight: 600;\r\n  color: var(--mn-fg);\r\n  background: var(--mn-surface-2);\r\n}\r\n\r\n.models-inspector__body {\r\n  flex: 1;\r\n  min-width: 0;\r\n  min-height: 0;\r\n  padding: 8px 16px 24px;\r\n  overflow-x: hidden;\r\n  overflow-y: auto;\r\n  scrollbar-gutter: stable;\r\n}\r\n\r\n.models-inspector__block {\r\n  padding: 16px 0;\r\n  border-bottom: 1px solid var(--mn-border);\r\n}\r\n\r\n/* Launch controls sit above the advanced accordion; its top border is enough. */\r\n.models-inspector__block:has(+ .models-advanced-stack) {\r\n  border-bottom: none;\r\n}\r\n\r\n.models-inspector__block:last-child {\r\n  border-bottom: none;\r\n}\r\n\r\n.models-inspector__sampler .settings-sampler-row {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 10px;\r\n  margin-top: 8px;\r\n}\r\n\r\n.models-inspector__sampler .settings-field-label {\r\n  font-size: 12px;\r\n  font-weight: 500;\r\n  color: var(--mn-fg-muted);\r\n}\r\n\r\n.models-inspector__sampler .settings-kv-input {\r\n  width: 100%;\r\n  box-sizing: border-box;\r\n}\r\n\r\n.models-inspector__sampler .models-link-row {\r\n  margin-top: 12px;\r\n}\r\n\r\n.models-inspector__footer {\r\n  display: flex;\r\n  flex-shrink: 0;\r\n  gap: 8px;\r\n  align-items: center;\r\n  box-sizing: border-box;\r\n  min-height: 56px;\r\n  padding: 12px 16px;\r\n  border-top: 1px solid var(--mn-border);\r\n  background: var(--mn-surface-1);\r\n}\r\n\r\n.models-inspector__footer:empty {\r\n  visibility: hidden;\r\n}\r\n\r\n.models-inspector__footer .models-btn {\r\n  flex: 1;\r\n  justify-content: center;\r\n}\r\n\r\n/* Label above any block of related controls or facts. */\r\n.models-block__label {\r\n  margin: 0 0 10px;\r\n  font-size: 11px;\r\n  font-weight: 600;\r\n  color: var(--mn-fg-muted);\r\n  letter-spacing: 0.08em;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.models-field-label {\r\n  margin: 12px 0 4px;\r\n  font-size: 11px;\r\n  font-weight: 600;\r\n  color: var(--mn-fg-muted);\r\n  letter-spacing: 0.06em;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.models-field-label:first-child {\r\n  margin-top: 0;\r\n}\r\n\r\n/* Definition list: label left, mono pill right, hairline between. */\r\n.models-info-list {\r\n  margin: 0;\r\n}\r\n\r\n.models-info-row {\r\n  display: flex;\r\n  gap: 12px;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  min-height: 32px;\r\n  padding: 4px 0;\r\n  border-bottom: 1px solid var(--mn-border);\r\n}\r\n\r\n.models-info-row:last-child {\r\n  border-bottom: none;\r\n}\r\n\r\n.models-info-row__label {\r\n  flex-shrink: 0;\r\n  font-size: 12px;\r\n  color: var(--mn-fg-muted);\r\n}\r\n\r\n.models-info-row__value {\r\n  min-width: 0;\r\n  margin: 0;\r\n  text-align: right;\r\n}\r\n\r\n.models-cap-cluster {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 4px;\r\n  justify-content: flex-end;\r\n}\r\n\r\n.models-link-row {\r\n  display: flex;\r\n  gap: 8px;\r\n  margin-top: 10px;\r\n}\r\n\r\n/* ------------------------------------------------------------- primitives */\r\n\r\n.models-chip {\r\n  display: inline-flex;\r\n  gap: 5px;\r\n  align-items: center;\r\n  max-width: 100%;\r\n  padding: 2px 8px;\r\n  overflow: hidden;\r\n  font-family: var(--font-mono);\